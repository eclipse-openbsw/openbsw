load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Interrupt-lock implementation. Every platform must declare this via its platform flags.
#   Override: --//libs/bsp/bspInterrupts:bsp_interrupts_impl=//path/to:your_impl
label_flag(
    name = "bsp_interrupts_impl",
    build_setting_default = "//bazel/config:no_implementation",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bsp_interrupts_headers",
    hdrs = [
        "include/interrupts/SuspendResumeAllInterruptsLock.h",
        "include/interrupts/SuspendResumeAllInterruptsScopedLock.h",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bsp_interrupts",
    visibility = ["//visibility:public"],
    deps = [
        ":bsp_interrupts_headers",
        ":bsp_interrupts_impl",
    ],
)

cc_library(
    name = "bsp_interrupts_gmock_headers",
    hdrs = [
        "mock/gmock/include/interrupts/SuspendResumeAllInterruptsMock.h",
        "mock/gmock/include/interrupts/disableEnableAllInterruptsMock.h",
    ],
    strip_include_prefix = "mock/gmock/include",
    target_compatible_with = ["//bazel/platform/constraints/build_variant:unit_test"],
    visibility = ["//visibility:public"],
    deps = [
        ":bsp_interrupts_mock_headers",
        "//libs/3rdparty/etl",
        "//libs/3rdparty/googletest:gtest",
    ],
)

cc_library(
    name = "bsp_interrupts_mock_headers",
    hdrs = [
        "mock/include/interrupts/disableEnableAllInterrupts.h",
        "mock/include/interrupts/suspendResumeAllInterrupts.h",
    ],
    strip_include_prefix = "mock/include",
    target_compatible_with = ["//bazel/platform/constraints/build_variant:unit_test"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bsp_interrupts_mock",
    srcs = [
        "mock/gmock/src/SuspendResumeAllInterruptsMock.cpp",
        "mock/gmock/src/disableEnableAllInterruptsMock.cpp",
    ],
    target_compatible_with = ["//bazel/platform/constraints/build_variant:unit_test"],
    visibility = ["//visibility:public"],
    deps = [
        ":bsp_interrupts_gmock_headers",
        ":bsp_interrupts_headers",
        ":bsp_interrupts_mock_headers",
        "//libs/3rdparty/etl",
        "//libs/3rdparty/googletest:gtest",
    ],
)
