load("@rules_cc//cc:cc_library.bzl", "cc_library")

alias(
    name = "bsp_interrupts_impl_default",
    actual = select(
        {
            "//bazel/config/executable_config:unit_test": ":bsp_interrupts_mock",
            "//bazel/platform/constraints/soc:s32k148": "//platforms/s32k1xx/bsp/bspInterruptsImpl:bsp_interrupts_impl",
            "@platforms//os:linux": "//platforms/posix/bsp/bspInterruptsImpl:bsp_interrupts_impl",
        },
        no_match_error = "No interrupt-lock implementation for this platform. Override --//libs/bsp/bspInterrupts:bsp_interrupts_impl with your own implementation target.",
    ),
)

# Interrupt-lock implementation
#   Default:  select based on the target platform (S32K148, POSIX)
#   Override: --//libs/bsp/bspInterrupts:bsp_interrupts_impl=//path/to:your_impl
label_flag(
    name = "bsp_interrupts_impl",
    build_setting_default = ":bsp_interrupts_impl_default",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bsp_interrupts_headers",
    hdrs = [
        "include/interrupts/SuspendResumeAllInterruptsLock.h",
        "include/interrupts/SuspendResumeAllInterruptsScopedLock.h",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bsp_interrupts",
    visibility = ["//visibility:public"],
    deps = [
        ":bsp_interrupts_headers",
        ":bsp_interrupts_impl",
    ],
)

cc_library(
    name = "bsp_interrupts_gmock_headers",
    hdrs = [
        "mock/gmock/include/interrupts/SuspendResumeAllInterruptsMock.h",
        "mock/gmock/include/interrupts/disableEnableAllInterruptsMock.h",
    ],
    strip_include_prefix = "mock/gmock/include",
    visibility = ["//visibility:public"],
    deps = [
        ":bsp_interrupts_mock_headers",
        "//libs/3rdparty/etl",
        "//libs/3rdparty/googletest:gtest",
    ],
)

cc_library(
    name = "bsp_interrupts_mock_headers",
    hdrs = [
        "mock/include/interrupts/disableEnableAllInterrupts.h",
        "mock/include/interrupts/suspendResumeAllInterrupts.h",
    ],
    strip_include_prefix = "mock/include",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/bsw/platform",
    ],
)

cc_library(
    name = "bsp_interrupts_mock",
    testonly = True,
    srcs = [
        "mock/gmock/src/SuspendResumeAllInterruptsMock.cpp",
        "mock/gmock/src/disableEnableAllInterruptsMock.cpp",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":bsp_interrupts_gmock_headers",
        ":bsp_interrupts_headers",
        ":bsp_interrupts_mock_headers",
        "//libs/3rdparty/etl",
        "//libs/3rdparty/googletest:gtest",
        "//libs/bsw/platform",
    ],
)
