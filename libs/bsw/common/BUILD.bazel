load("@rules_cc//cc:cc_library.bzl", "cc_library")

#   Default:  //bazel/config:no_implementation
#   Override: --//libs/bsw/common:configuration=//executables/<app>/configuration
label_flag(
    name = "configuration",
    build_setting_default = "//bazel/config:no_implementation",
    visibility = ["//visibility:public"],
)

# common_headers is split out so that the configuration target can depend on it
# without a dependency cycle.
cc_library(
    name = "common_headers",
    hdrs = [
        "include/common/busid/BusId.h",
        "include/util/Mask.h",
        "include/util/concurrent/IFutureSupport.h",
        "include/util/timeout/ITimeoutManager2.h",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/3rdparty/etl",
    ],
)

cc_library(
    name = "common",
    visibility = ["//visibility:public"],
    deps = [":common_headers"],
)
