load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Override via --//libs/bsw/loggerIntegration:etl_impl=<your_etl_impl_target>
label_flag(
    name = "etl_impl",
    build_setting_default = "//bazel/config:no_implementation",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "logger_integration",
    srcs = [
        "src/logger/LoggerComposition.cpp",
        "src/logger/LoggerTime.cpp",
    ],
    hdrs = [
        "include/logger/Config.h",
        "include/logger/ConsoleEntryFormatter.h",
        "include/logger/LoggerComposition.h",
        "include/logger/LoggerTime.h",
    ],
    implementation_deps = [
        ":etl_impl",
        "//libs/3rdparty/etl",
        "//libs/bsp/bspInterrupts:bsp_interrupts",
        "//libs/bsw/logger",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)
