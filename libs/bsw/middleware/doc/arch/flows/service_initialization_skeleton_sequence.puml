@startuml

hide footbox

actor "Generated\nSkeleton" as generated_skeleton
participant "Proxy/Skeleton Base" as proxy_skeleton_base_unit
participant "Instance Database" as instance_database_unit
participant "Cluster Connection" as cluster_connection_unit

activate proxy_skeleton_base_unit
activate instance_database_unit
activate cluster_connection_unit

generated_skeleton -> proxy_skeleton_base_unit : init(instanceId)
proxy_skeleton_base_unit -> proxy_skeleton_base_unit : validate state (must be uninitialized)
proxy_skeleton_base_unit -> instance_database_unit : find instance configuration

alt instance found with client connections
    instance_database_unit --> proxy_skeleton_base_unit : connections[] info
    loop for each connection
        proxy_skeleton_base_unit -> cluster_connection_unit : subscribe(skeleton, instanceId)
        cluster_connection_unit -> cluster_connection_unit : register skeleton in transceivers
        cluster_connection_unit --> proxy_skeleton_base_unit : HRESULT::Ok
    end
    proxy_skeleton_base_unit -> proxy_skeleton_base_unit : setState(initialized)
    proxy_skeleton_base_unit --> generated_skeleton : HRESULT::Ok
else instance found without client connections
    instance_database_unit --> proxy_skeleton_base_unit : empty connections[]
    proxy_skeleton_base_unit -> proxy_skeleton_base_unit : logError(NoClientsAvailable)
    proxy_skeleton_base_unit --> generated_skeleton : HRESULT::NoClientsAvailable
else instance not found
    instance_database_unit --> proxy_skeleton_base_unit : nullptr
    proxy_skeleton_base_unit -> proxy_skeleton_base_unit : logError(TransceiverInitializationFailed)
    proxy_skeleton_base_unit --> generated_skeleton : HRESULT::TransceiverInitializationFailed
end

deactivate proxy_skeleton_base_unit
deactivate instance_database_unit
deactivate cluster_connection_unit

@enduml
