    name = "middleware_hdrs",
    hdrs = [
        ":middleware_memory_hdrs",
        ":middleware_queue_hdrs",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":middleware_interfaces",
        "//libs/3rdparty/etl",
    ],
)

