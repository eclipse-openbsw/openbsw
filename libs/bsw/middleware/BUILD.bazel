load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel/config/build_variant:compatibility.bzl", "unit_test_only")

cc_library(
    name = "middleware_lock_types_test_stub",
    hdrs = ["test/include/middleware/concurrency/lock_types.h"],
    strip_include_prefix = "test/include",
)

#   unit_test     -> host no-op stub
#   reference_app -> platform integration stub (replace with a concrete lock_types target)
alias(
    name = "middleware_lock_types_default",
    actual = select(
        {
            "//bazel/config/build_variant:unit_test": ":middleware_lock_types_test_stub",
            "//bazel/config/build_variant:reference_app": ":middleware_lock_types_test_stub",
        },
        no_match_error = "Set build_variant to 'reference_app' or 'unit_test', or override --//libs/bsw/middleware:middleware_lock_types",
    ),
)

# lock_types.h provider. Platform integration supplies the concrete types at build time.
#   Default:  host no-op stub (per build_variant)
#   Override: --//libs/bsw/middleware:middleware_lock_types=//<your>:lock_types
label_flag(
    name = "middleware_lock_types",
    build_setting_default = ":middleware_lock_types_default",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "middleware_interfaces",
    hdrs = [
        "interfaces/include/middleware/concurrency/LockStrategies.h",
        "interfaces/include/middleware/logger/Logger.h",
        "interfaces/include/middleware/os/TaskIdProvider.h",
        "interfaces/include/middleware/time/SystemTimerProvider.h",
    ],
    strip_include_prefix = "interfaces/include",
    visibility = ["//visibility:public"],
    deps = [
        ":middleware_lock_types",
        "//libs/3rdparty/etl",
    ],
)

cc_library(
    name = "middleware",
    srcs = glob(["src/**/*.cpp"]),
    hdrs = glob(["include/**/*.h"]),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":middleware_interfaces",
        "//libs/3rdparty/etl",
    ],
)

cc_library(
    name = "middleware_mock",
    hdrs = ["test/mock/include/util/crtp_mock.h"],
    strip_include_prefix = "test/mock/include",
    target_compatible_with = unit_test_only(),
    visibility = ["//visibility:public"],
    deps = ["//libs/3rdparty/etl"],
)

