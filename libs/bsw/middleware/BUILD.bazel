# Base for the mocks emitted by the middleware code generator.
cc_library(
    name = "middleware_mock",
    hdrs = ["test/mock/include/util/crtp_mock.h"],
    strip_include_prefix = "test/mock/include",
    target_compatible_with = unit_test_only(),
    visibility = ["//visibility:public"],
    deps = ["//libs/3rdparty/etl"],
)

cc_library(
    name = "middleware_test_support",
    testonly = True,
    srcs = [
        "test/src/logger/mock/LoggerMock.cpp",
        "test/src/memory/mock/AllocatorMock.cpp",
        "test/src/os/OsDefinitions.cpp",
        "test/src/time/mock/SystemTimerProviderMock.cpp",
    ],
    hdrs = [
        "test/src/core/InstancesDatabase.h",
        "test/src/core/Proxy.h",
        "test/src/core/ProxyAttributesUnderTest.h",
        "test/src/core/ReferenceApp.h",
        "test/src/core/Skeleton.h",
        "test/src/core/mock/ClusterConnectionMock.h",
        "test/src/core/mock/ProxyMock.h",
        "test/src/logger/DslLogger.h",
        "test/src/logger/mock/LoggerMock.h",
        "test/src/memory/mock/AllocatorMock.h",
        "test/src/time/mock/SystemTimerProviderMock.h",
    ],
    strip_include_prefix = "test/src",
    target_compatible_with = unit_test_only(),
    deps = [
        ":middleware",
        ":middleware_concurrency_mock",
        "//libs/3rdparty/etl",
        "//libs/3rdparty/googletest:gtest",
    ],
    # The mocks define symbols that :middleware references but the tests do not.
    alwayslink = True,
)

# libmiddleware.so references the platform hooks, so every test binary needs a definition.
cc_library(
    name = "middleware_concurrency_mock",
    srcs = ["test/src/concurrency/mock/ConcurrencyMock.cpp"],
    hdrs = ["test/src/concurrency/mock/ConcurrencyMock.h"],
    strip_include_prefix = "test/src",
    target_compatible_with = unit_test_only(),
    deps = [
        ":middleware_interfaces",
        "//libs/3rdparty/googletest:gtest",
    ],
    alwayslink = True,
)

