load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# ---- concurrency -----------------------------------------------------------

# Default is a no-op stub, not a mock: production packages must not depend on
# test sources, and reference_app/unit_test consumers already supply their own
# real implementation via middleware_config (see referenceApp/middlewareConfiguration
# and libs/bsw/middleware/test BUILD.bazel).
cc_library(
    name = "concurrency_impl_default",
    hdrs = ["src/noop/concurrency/middleware/concurrency/lock_types.h"],
    strip_include_prefix = "src/noop/concurrency",
)

label_flag(
    name = "concurrency_impl",
    build_setting_default = ":concurrency_impl_default",
)

cc_library(
    name = "concurrency",
    hdrs = ["include/middleware/concurrency/LockStrategies.h"],
    strip_include_prefix = "include",
    deps = [":concurrency_impl"],
)

filegroup(
    name = "concurrency_code_to_doc",
    srcs = ["include/middleware/concurrency/LockStrategies.h"],
)

# ---- logger ----------------------------------------------------------------

# Default is a no-op stub; see the note on concurrency_impl_default above.
cc_library(
    name = "logger_impl_default",
    srcs = ["src/noop/logger/LoggerNoop.cpp"],
    deps = [
        ":logger",
        "//libs/3rdparty/etl",
    ],
)

label_flag(
    name = "logger_impl",
    build_setting_default = ":logger_impl_default",
