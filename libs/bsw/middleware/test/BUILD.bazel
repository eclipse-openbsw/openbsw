load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//libs/bsw/middleware:configurable_middleware.bzl", "middleware_config")

package(default_visibility = ["//libs/bsw/middleware/test:__subpackages__"])

# ---------------------------------------------------------------------------
# Test support targets for libs/bsw/middleware.
# ---------------------------------------------------------------------------

# ---- concurrency -----------------------------------------------------------

cc_library(
    name = "concurrency_mock_impl",
    hdrs = ["src/mock/concurrency/middleware/concurrency/lock_types.h"],
    strip_include_prefix = "src/mock/concurrency",
    visibility = ["//visibility:public"],
)

# ---- logger ----------------------------------------------------------------

cc_library(
    name = "logger_mock_impl",
    srcs = ["src/mock/logger/mock/LoggerMock.cpp"],
    hdrs = [
        "src/mock/logger/DslLogger.h",
        "src/mock/logger/mock/LoggerMock.h",
    ],
    strip_include_prefix = "src/mock",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/3rdparty/googletest:gtest",
        "//libs/bsw/middleware/interfaces:logger",
    ],
)

# ---- os --------------------------------------------------------------------

cc_library(
    name = "os_mock_impl",
    srcs = ["src/mock/os/OsDefinitions.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        "//libs/bsw/middleware/interfaces:os",
    ],
)

# ---- time ------------------------------------------------------------------

cc_library(
    name = "time_mock_impl",
    srcs = ["src/mock/time/mock/SystemTimerProviderMock.cpp"],
    hdrs = ["src/mock/time/mock/SystemTimerProviderMock.h"],
    strip_include_prefix = "src/mock",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/3rdparty/etl",
        "//libs/3rdparty/googletest:gtest",
        "//libs/bsw/middleware/interfaces:time",
    ],
)

# ---- memory ----------------------------------------------------------------

cc_library(
    name = "memory_mock_impl",
    srcs = ["src/mock/memory/mock/AllocatorMock.cpp"],
    hdrs = ["src/mock/memory/mock/AllocatorMock.h"],
    strip_include_prefix = "src/mock",
    visibility = ["//visibility:public"],
    deps = [
        ":memory_test_impl",
        "//libs/3rdparty/googletest:gtest",
    ],
)

# ---- test source filegroups ------------------------------------------------

filegroup(
    name = "core_test_code_to_doc",
    srcs = [
        "src/core/ClusterConfigurationTest.cpp",
        "src/core/ConnectionTest.cpp",
        "src/core/DbManipulatorTest.cpp",
        "src/core/LoggerApi.cpp",
        "src/core/MessagePayloadBuilderTest.cpp",
        "src/core/MessageTest.cpp",
        "src/core/ProxyAttributesTest.cpp",
        "src/core/ProxyBaseTest.cpp",
        "src/core/ResponseBufferTest.cpp",
        "src/core/SkeletonAttributeTest.cpp",
        "src/core/SkeletonBaseTest.cpp",
        "src/core/rpc/ProxyFireAndForgetMethodTest.cpp",
        "src/core/rpc/ProxyMethodTest.cpp",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "memory_test_code_to_doc",
    srcs = [
        "src/memory/AggregatorTest.cpp",
        "src/memory/AllocatorBaseTest.cpp",
        "src/memory/PoolsTest.cpp",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "queue_test_code_to_doc",
    srcs = ["src/queue/QueueTest.cpp"],
    visibility = ["//visibility:public"],
)

