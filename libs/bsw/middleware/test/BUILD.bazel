        "//libs/3rdparty/etl:etl_profile": "//executables/unitTest/etl_profile:etl_profile",
        "//libs/bsw/middleware/interfaces:concurrency_impl": ":concurrency_mock_impl",
        "//libs/bsw/middleware/interfaces:logger_impl": ":logger_mock_impl",
        "//libs/bsw/middleware/interfaces:os_impl": ":os_mock_impl",
