load("@middleware_pip//:requirements.bzl", "requirement")
load("@rules_python//python:py_binary.bzl", "py_binary")

# Staged as genrule srcs so jinja2cpp.py can resolve --input via
# Path.resolve() from the sandbox execroot.
filegroup(
    name = "generator_templates",
    srcs = [
        "templates/jinja/cluster_connections_srcCluster_to_tgtCluster.h.jinja",
        "templates/jinja/cluster_id.h.jinja",
        "templates/jinja/macros/common.jinja",
        "templates/jinja/macros/signals.jinja",
        "templates/jinja/macros/transmission_mode.jinja",
        "templates/jinja/mock/service/proxy_mock.cpp.jinja",
        "templates/jinja/mock/service/proxy_mock.h.jinja",
        "templates/jinja/mock/service/skeleton_mock.cpp.jinja",
        "templates/jinja/mock/service/skeleton_mock.h.jinja",
        "templates/jinja/mock/signal/pdu_reader_mock.cpp.jinja",
        "templates/jinja/mock/signal/pdu_reader_mock.h.jinja",
        "templates/jinja/service/cluster_srcCluster.cpp.jinja",
        "templates/jinja/service/cluster_srcCluster.h.jinja",
        "templates/jinja/service/common.cpp.jinja",
        "templates/jinja/service/common.h.jinja",
        "templates/jinja/service/proxy.cpp.jinja",
        "templates/jinja/service/proxy.h.jinja",
        "templates/jinja/service/skeleton.cpp.jinja",
        "templates/jinja/service/skeleton.h.jinja",
        "templates/jinja/shm/allocator_selector_definitions.cpp.jinja",
        "templates/jinja/shm/allocators_definitions.h.jinja",
        "templates/jinja/shm/config.cpp.jinja",
        "templates/jinja/shm/config.h.jinja",
        "templates/jinja/shm/pdu_definitions.h.jinja",
        "templates/jinja/shm/queue_definitions.h.jinja",
        "templates/jinja/signal/pdu_common.h.jinja",
        "templates/jinja/signal/pdu_reader.cpp.jinja",
        "templates/jinja/signal/pdu_reader.h.jinja",
        "templates/schemas/deployment.yaml",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "jinja2cpp",
    srcs = ["jinja2cpp.py"] + glob(["flync2middleware/*.py"]),
    legacy_create_init = 0,
    python_version = "3.12.3",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("jinja2"),
        requirement("jsonschema"),
        requirement("pyyaml"),
    ],
)
