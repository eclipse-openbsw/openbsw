load("@middleware_pip//:requirements.bzl", "requirement")
load("@rules_python//python:py_binary.bzl", "py_binary")

# Staged as genrule srcs so jinja2cpp.py can resolve --input via
# Path.resolve() from the sandbox execroot.
filegroup(
    name = "generator_templates",
    srcs = [
        "templates/jinja/cluster_id.h.jinja",
        "templates/jinja/datatypes.h.jinja",
        "templates/jinja/macros/cluster_connections.jinja",
        "templates/jinja/macros/common.jinja",
        "templates/jinja/macros/signals.jinja",
        "templates/jinja/macros/transmission_mode.jinja",
        "templates/jinja/mock/sig/pdu_reader_mock.cpp.jinja",
        "templates/jinja/mock/sig/pdu_reader_mock.h.jinja",
        "templates/jinja/mock/svc/proxy_mock.cpp.jinja",
        "templates/jinja/mock/svc/proxy_mock.h.jinja",
        "templates/jinja/mock/svc/skeleton_mock.cpp.jinja",
        "templates/jinja/mock/svc/skeleton_mock.h.jinja",
        "templates/jinja/shm/allocator_selector_definitions.cpp.jinja",
        "templates/jinja/shm/allocators_definitions.h.jinja",
        "templates/jinja/shm/config.cpp.jinja",
        "templates/jinja/shm/config.h.jinja",
        "templates/jinja/shm/pdu_definitions.h.jinja",
        "templates/jinja/shm/queue_definitions.h.jinja",
        "templates/jinja/sig/pdu_common.h.jinja",
        "templates/jinja/sig/pdu_reader.cpp.jinja",
        "templates/jinja/sig/pdu_reader.h.jinja",
        "templates/jinja/sig/pdu_writer.cpp.jinja",
        "templates/jinja/sig/pdu_writer.h.jinja",
        "templates/jinja/svc/cluster_srcCluster.cpp.jinja",
        "templates/jinja/svc/cluster_srcCluster.h.jinja",
        "templates/jinja/svc/common.cpp.jinja",
        "templates/jinja/svc/common.h.jinja",
        "templates/jinja/svc/proxy.cpp.jinja",
        "templates/jinja/svc/proxy.h.jinja",
        "templates/jinja/svc/skeleton.cpp.jinja",
        "templates/jinja/svc/skeleton.h.jinja",
        "templates/schemas/deployment.yaml",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "jinja2cpp",
    srcs = [
        "filters/__init__.py",
        "filters/camel_case.py",
        "filters/cpp_type.py",
        "filters/pascal_case.py",
        "jinja2cpp.py",
        "loaders/__init__.py",
        "loaders/connections_loader.py",
        "loaders/datatypes_loader.py",
        "model_enricher.py",
    ],
    imports = ["."],
    legacy_create_init = 0,
    python_version = "3.12.3",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("jinja2"),
        requirement("jsonschema"),
        requirement("pyyaml"),
    ],
)
