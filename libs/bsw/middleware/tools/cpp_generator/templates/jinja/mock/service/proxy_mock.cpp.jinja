// EVENTS
{% for broadcast in service.broadcasts %}
{%- set namePascalCase = broadcast.name | pascalCase %}
{{ namePascalCase }}Event::{{ namePascalCase }}Event(::middleware::core::ProxyBase& proxy) : impl_(proxy)
{
}

void {{ namePascalCase }}Event::setReceiveHandler(const OnFieldChangedCallback callback)
{
    auto* mock = {{ service.name }}ProxyMock::getMock();
    mock->{{ broadcast.name | camelCase }}.setReceiveHandler(callback);
}

void {{ namePascalCase }}Event::unsetReceiveHandler()
{
    auto* mock = {{ service.name }}ProxyMock::getMock();
    mock->{{ broadcast.name | camelCase }}.unsetReceiveHandler();
}
{% endfor %}

// ATTRIBUTES
{% for attribute in service.attributes %}
{%- set namePascalCase = attribute.name | pascalCase %}
{%- set _has_subscription = attribute.hasNotifier %}
{%- set _has_setter = attribute.hasSetter %}
{%- set _set_as_method = attribute.deployment.SetterWithResponse and attribute.hasSetter %}
{{ namePascalCase }}Attribute::{{ namePascalCase }}Attribute(::middleware::core::ProxyBase& proxy) : impl_(proxy)
{
}

etl::expected<uint16_t, ::middleware::core::HRESULT> {{ namePascalCase }}Attribute::get(const GetterCallback attrCb)
{
    auto* mock = {{ service.name }}ProxyMock::getMock();
    return mock->{{ attribute.name | camelCase }}.get(attrCb);
}

::middleware::core::HRESULT {{ namePascalCase }}Attribute::cancelGetterRequest(uint16_t requestId)
{
    auto* mock = {{ service.name }}ProxyMock::getMock();
    return mock->{{ attribute.name | camelCase }}.cancelGetterRequest(requestId);
}
