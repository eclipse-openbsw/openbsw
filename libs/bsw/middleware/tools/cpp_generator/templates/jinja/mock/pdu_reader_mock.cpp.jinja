#include "{{ pdu.headers.reader }}"
#include "{{ pdu.headers.reader_mock }}"

namespace {{ pdu.namespace }}
{

{{ pdu.name }}Reader::{{ pdu.name }}Reader(IQualifier* const qualifier)
: qualifier_(qualifier)
{
    // The mock never qualifies; avoids clang's -Wunused-private-field on the shared header.
    static_cast<void>(qualifier_);
}

{{ pdu.name }} {{ pdu.name }}Reader::read()
{
    return {{ pdu.name }}ReaderMock::getMock()->read();
}

}  // namespace {{ pdu.namespace }}
