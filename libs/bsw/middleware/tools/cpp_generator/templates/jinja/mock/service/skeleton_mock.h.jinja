{% from "macros/common.jinja" import file_header %}{{ file_header() }}
#pragma once

#include <gmock/gmock.h>

#include "{{ service.commonInclude }}"
#include "{{ service.skeletonInclude }}"
#include "middleware/core/types.h"
#include "util/crtp_mock.h"

namespace {{ service.namespace | lower }}::{{ service.name }}::skeleton
{

class {{ service.name }}SkeletonMock : public middleware::util::CrtpMock<{{ service.name }}SkeletonMock>
{
  public:
    using ResponseInfo = {{ service.name }}Skeleton::ResponseInfo;

    {{ service.name }}SkeletonMock() = default;
    virtual ~{{ service.name }}SkeletonMock() = default;

    MOCK_METHOD(middleware::core::HRESULT, init, (uint16_t instanceId));
    MOCK_METHOD(void, deInit, ());
    MOCK_METHOD(bool, isInitialized, (), (const));
    MOCK_METHOD(uint16_t, getServiceId, (), (const));

    // METHODS
{% for method in service.methods %}
{% set nameCamelCase = method.name | camelCase %}
{% set namePascalCase = method.name | pascalCase %}
{% if not method.fireAndForget %}
    {% if method.inArgs %}
    MOCK_METHOD(void, {{ nameCamelCase }}, (const {{ method.inType | cppType(service.namespace) }}& {{ nameCamelCase }}Input, ResponseInfo& response));
    {% else %}
    MOCK_METHOD(void, {{ nameCamelCase }}, (ResponseInfo & response));
    {% endif %}
    {% if method.outArgs %}
    MOCK_METHOD(middleware::core::HRESULT, respond{{ namePascalCase }}, (ResponseInfo & response, const {{ method.outType | cppType(service.namespace) }}& result, const bool handleResponseFailure));
    {% else %}
    MOCK_METHOD(middleware::core::HRESULT, respond{{ namePascalCase }}, (ResponseInfo & response, const bool handleResponseFailure));
    {% endif %}
    MOCK_METHOD(middleware::core::HRESULT, cancel{{ namePascalCase }}Response, (ResponseInfo & response));
{% else %}
    {% if method.inArgs %}
    MOCK_METHOD(void, {{ nameCamelCase }}, (const {{ method.inType | cppType(service.namespace) }}& {{ nameCamelCase }}Input));
    {% else %}
    MOCK_METHOD(void, {{ nameCamelCase }}, ());
    {% endif %}
{% endif %}
{% endfor %}

    // ATTRIBUTES
{% for attribute in service.attributes %}
{% set nameCamelCase = attribute.name | camelCase %}
{% set namePascalCase = attribute.name | pascalCase %}
{% if attribute.hasGetter %}
    MOCK_METHOD(void, get{{ namePascalCase }}Attribute, (ResponseInfo & response));
    MOCK_METHOD(middleware::core::HRESULT, respondGet{{ namePascalCase }}Attribute, (ResponseInfo & response, const {{ attribute.type | cppType(service.namespace) }}& result, const bool handleResponseFailure));
    MOCK_METHOD(middleware::core::HRESULT, cancelGet{{ namePascalCase }}AttributeResponse, (ResponseInfo & response));
{% endif %}
{% if attribute.hasSetter %}
    {% if attribute.deployment.SetterWithResponse %}
    MOCK_METHOD(void, set{{ namePascalCase }}Attribute, (const {{ attribute.type | cppType(service.namespace) }}& {{ nameCamelCase }}, ResponseInfo& response));
    MOCK_METHOD(middleware::core::HRESULT, respondSet{{ namePascalCase }}Attribute, (ResponseInfo & response, const {{ attribute.type | cppType(service.namespace) }}& result, const bool handleResponseFailure));
    MOCK_METHOD(middleware::core::HRESULT, cancelSet{{ namePascalCase }}AttributeResponse, (ResponseInfo & response));
    {% else %}
    MOCK_METHOD(void, set{{ namePascalCase }}Attribute, (const {{ attribute.type | cppType(service.namespace) }}& {{ nameCamelCase }}));
    {% endif %}
{% endif %}
{% if attribute.hasNotifier %}
    class {{ namePascalCase }}AttributeMock
    {
      public:
        MOCK_METHOD(middleware::core::HRESULT, send, ());
    };

    ::testing::NiceMock<{{ namePascalCase }}AttributeMock> {{ nameCamelCase }};
{% endif %}
{% endfor %}

{% for broadcast in service.broadcasts %}
    class {{ broadcast.name | pascalCase }}EventMock
    {
      public:
{% if broadcast.type.name != 'void' %}
        MOCK_METHOD(middleware::core::HRESULT, send, (const {{ broadcast.type | cppType(service.namespace) }}& data));
{% else %}
        MOCK_METHOD(middleware::core::HRESULT, send, ());
{% endif %}
    };

    ::testing::NiceMock<{{ broadcast.name | pascalCase }}EventMock> {{ broadcast.name | camelCase }};
{% endfor %}

};

using {{ service.name }}SkeletonMockFacade = ::testing::NiceMock<{{ service.name }}SkeletonMock>;

}  // namespace {{ service.namespace | lower }}::{{ service.name }}::skeleton
