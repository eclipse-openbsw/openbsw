{% from "macros/common.jinja" import file_header %}{{ file_header() }}
#include "{{ service.commonInclude }}"

#include <etl/array.h>
#include <etl/type_traits.h>

#include "middleware/ClusterId.h"
#include "middleware/svc/core/InstancesDatabase.h"

{% set deploymentClusters = [] %}
{% for cluster in clusters %}
  {% for port in cluster.providedPorts %}
    {% if port.interfaceName == service.name and port.interfaceNamespace == service.namespace %}
      {% set _ = deploymentClusters.append(cluster) %}
    {% endif %}
  {% endfor %}
  {% for port in cluster.requiredPorts %}
    {% if port.interfaceName == service.name and port.interfaceNamespace == service.namespace %}
      {% set _ = deploymentClusters.append(cluster) %}
    {% endif %}
  {% endfor %}
  {% for intraConnection in cluster.connections %}
    {% if intraConnection.providedPort.interfaceName == service.name and intraConnection.providedPort.interfaceNamespace == service.namespace %}
      {% set _ = deploymentClusters.append(cluster) %}
    {% endif %}
  {% endfor %}
{% endfor %}
{% set deploymentClusters = deploymentClusters | unique | list %}
{% for cluster in deploymentClusters %}
#include "middleware/{{ cluster.name }}Cluster.h"
{% endfor %}

namespace {{ service.namespace | lower }}::{{ service.name }}::internal
{

{%- for cluster in deploymentClusters %}
  {% set ns = namespace(instanceNames = []) %}
  {% for componentInstance in cluster.componentInstances %}
      {% for providedPort in componentInstance.component.providedPorts %}
          {% if providedPort.interfaceName == service.name and providedPort.interfaceNamespace == service.namespace %}
              {% set _ = ns.instanceNames.append((cluster.name | pascalCase) ~ (componentInstance.instanceName | pascalCase ) ~ (providedPort.name | pascalCase)) %}
          {% endif %}
      {% endfor %}
  {% endfor %}
  {% set ns.instanceNames = ns.instanceNames | unique | sort %}

  {# Skeletons of this cluster serve every cluster this cluster provides the service to.
     Dedupe: a connection may list the same service multiple times. #}
  {% set skeletonConnections = [] %}
  {% for connection in connections %}
    {% if connection.sourceCluster.name == cluster.name %}
      {% for provider in connection.providers %}
        {% if provider.name == service.name and provider.namespace == service.namespace and connection not in skeletonConnections %}
          {% set _ = skeletonConnections.append(connection) %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}

  {# Proxies of this cluster reach the providers hosted by the target cluster of each connection. #}
  {% set proxyConnections = [] %}
  {% for connection in connections %}
    {% if connection.sourceCluster.name == cluster.name %}
      {% for consumer in connection.consumers %}
        {% if consumer.name == service.name and consumer.namespace == service.namespace and connection not in proxyConnections %}
          {% set _ = proxyConnections.append(connection) %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}

class InstancesDatabase{{ cluster.name }} : public ::middleware::svc::core::IInstanceDatabase
{
  public:
    constexpr InstancesDatabase{{ cluster.name }}() = default;

    uint8_t getClusterId() const final
    {
        return etl::to_underlying(::middleware::svc::core::ClusterId::{{ cluster.name }});
    }

    ::etl::span<::middleware::svc::core::IClusterConnection* const> getSkeletonConnectionsRange() const final
    {
  {% if skeletonConnections %}
        static constexpr ::etl::array<::middleware::svc::core::IClusterConnection* const, {{ skeletonConnections | length }}U> connections = {
      {% for connection in skeletonConnections %}
            &::middleware::ClusterConnection{{ connection.sourceCluster.name }}To{{ connection.targetCluster.name }}{{ "," if not loop.last }}
      {% endfor %}
        };
        return ::etl::make_span(connections);
  {% else %}
        return ::etl::span<::middleware::svc::core::IClusterConnection* const>();
  {% endif %}
    }

    /** Resolves the connection towards the cluster that hosts \p instanceId. */
    ::middleware::svc::core::IClusterConnection* getProxyConnection(
  {% if proxyConnections %}
        uint16_t const instanceId) const final
    {
        switch (instanceId)
        {
      {% for connection in proxyConnections %}
        {% set targetInstances = [] %}
        {% for componentInstance in connection.targetCluster.componentInstances %}
          {% for providedPort in componentInstance.component.providedPorts %}
            {% if providedPort.interfaceName == service.name and providedPort.interfaceNamespace == service.namespace %}
              {% set _ = targetInstances.append((connection.targetCluster.name | pascalCase) ~ (componentInstance.instanceName | pascalCase) ~ (providedPort.name | pascalCase)) %}
            {% endif %}
          {% endfor %}
        {% endfor %}
        {% for instanceName in targetInstances | unique | sort %}
            case InstanceId::{{ instanceName | pascalCase }}:
        {% endfor %}
        {% if targetInstances %}
                return &::middleware::ClusterConnection{{ connection.sourceCluster.name }}To{{ connection.targetCluster.name }};
        {% endif %}
      {% endfor %}
            default:
                return nullptr;
        }
    }
  {% else %}
        uint16_t const) const final
    {
        return nullptr;
    }
  {% endif %}

    ::etl::span<const uint16_t> getOwnInstanceIdsRange() const final
    {
        return ::etl::make_span(fInstanceIds);
    }

  private:
    static constexpr etl::array<const uint16_t, {{ ns.instanceNames | length }}U> fInstanceIds = {
  {% for instanceName in ns.instanceNames %}
        InstanceId::{{ instanceName | pascalCase }}{{ "," if not loop.last }}
  {% endfor %}
    };
};

constexpr etl::array<const uint16_t, {{ ns.instanceNames | length }}U> InstancesDatabase{{ cluster.name }}::fInstanceIds;

constexpr InstancesDatabase{{ cluster.name }} _InstancesDatabase{{ cluster.name }};
{% endfor %}

{% if deploymentClusters %}
constexpr etl::array<const ::middleware::svc::core::IInstanceDatabase* const, {{ deploymentClusters | length }}U> instancesDatabase{
    {% for cluster in deploymentClusters %}
    &_InstancesDatabase{{ cluster.name }}{{ "," if not loop.last }}
    {% endfor %}
};
{% endif %}

::etl::span<const ::middleware::svc::core::IInstanceDatabase* const> getClusterConnectionsDb()
{
    {% if deploymentClusters %}
    return ::etl::make_span(instancesDatabase);
    {% else %}
    return ::etl::span<const ::middleware::svc::core::IInstanceDatabase* const>();
    {% endif %}
}

}  // namespace {{ service.namespace | lower }}::{{ service.name }}::internal
