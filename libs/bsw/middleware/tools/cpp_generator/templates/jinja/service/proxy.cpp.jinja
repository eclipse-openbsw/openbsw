::middleware::core::HRESULT {{ service.name }}Proxy::onNewMessageReceived(::middleware::core::Message const& msg)
{
    ::middleware::core::HRESULT ret = ::middleware::core::HRESULT::Ok;
    checkCrossThreadError(fProcessId);
    switch (msg.getHeader().memberId)
    {
        // ATTRIBUTES
{% for attribute in service.attributes %}
{% set nameCamelCase = attribute.name | camelCase %}
{% set namePascalCase = attribute.name | pascalCase %}
  {% if attribute.hasGetter %}
        case internal::get_{{ namePascalCase }}_id: {
            {{ nameCamelCase }}.impl_.answerGetterRequest(msg);
            break;
        }
  {% endif %}
  {% if attribute.hasSetter and attribute.deployment.SetterWithResponse %}
        case internal::set_{{ namePascalCase }}_id: {
            {{ nameCamelCase }}.impl_.answerSetterRequest(msg);
            break;
        }
  {% endif %}
  {% if attribute.hasNotifier %}
        case internal::event_{{ namePascalCase }}_id: {
            {{ nameCamelCase }}.impl_.setEvent_(msg);
            break;
        }
  {% endif %}
{% endfor %}
        // EVENTS
{% for broadcast in service.broadcasts %}
        case internal::event_{{ broadcast.name | pascalCase }}_id: {
            {{ broadcast.name | camelCase }}.impl_.setEvent_(msg);
            break;
        }
{% endfor %}
        // METHODS
{% for method in service.methods %}
{% if not method.fireAndForget %}
        case internal::{{ method.name | camelCase }}_id: {
            {{ method.name | camelCase }}Method_.answerRequest(msg);
            break;
        }
{% endif %}
{% endfor %}
        default: {
            ret = ::middleware::core::HRESULT::ServiceMemberIdNotFound;
            break;
        }
    }
    return ret;
}

void {{ service.name }}Proxy::futureDispatcherDeinitialization()
{
    checkCrossThreadError(fProcessId);
    // ATTRIBUTES
{% for attribute in service.attributes %}
    {{ attribute.name | camelCase }}.impl_.freeAll();
{% endfor %}
    // METHODS
{% for method in service.methods %}
{% if not method.fireAndForget %}
    {{ method.name | camelCase }}Method_.freeAll();
{% endif %}
{% endfor %}
}

void {{ service.name }}Proxy::updateTimeouts()
{
    doUpdateTimeouts();
}

void {{ service.name }}Proxy::doUpdateTimeouts()
{
    checkCrossThreadError(fProcessId);
    // ATTRIBUTES
{% for attribute in service.attributes %}
{% if attribute.deployment.Timeout > 0 and ((attribute.deployment.GetterID is not none) or (attribute.deployment.SetterID is not none)) %}
    {{ attribute.name | camelCase }}.impl_.updateTimeouts();
  {% endif %}
{% endfor %}
    // METHODS
{% for method in service.methods %}
{% if not method.fireAndForget %}
    {{ method.name | camelCase }}Method_.updateTimeouts();
{% endif %}
{% endfor %}
}

