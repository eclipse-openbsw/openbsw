{% from "macros/common.jinja" import file_header %}{{ file_header() }}
#pragma once

#include "{{ service.commonInclude }}"

namespace {{ service.namespace | lower }}::{{ service.name }}::skeleton
{

// ATTRIBUTES
{% for attribute in service.attributes %}
{% set namePascalCase = attribute.name | pascalCase %}
class {{ namePascalCase }}Attribute
{
  public:
    using AttributeType = {{ attribute.type | cppType(service.namespace) }};

    explicit {{ namePascalCase }}Attribute(::middleware::core::SkeletonBase& skeleton) : impl_(skeleton) {}
    {{ namePascalCase }}Attribute(const {{ namePascalCase }}Attribute&) = delete;
    {{ namePascalCase }}Attribute({{ namePascalCase }}Attribute&&) = delete;
    {{ namePascalCase }}Attribute& operator=(const {{ namePascalCase }}Attribute&) = delete;
    {{ namePascalCase }}Attribute& operator=({{ namePascalCase }}Attribute&&) = delete;
    const AttributeType& get() const;
    AttributeType& get();
    void set(const AttributeType& value);
{% if attribute.hasNotifier %}
    [[nodiscard]] ::middleware::core::HRESULT send();
{% endif %}

  private:
{% if attribute.hasNotifier %}
    using Impl = ::middleware::core::SkeletonAttribute<AttributeType, internal::event_{{ namePascalCase }}_id, true>;
{% else %}
    using Impl = ::middleware::core::SkeletonAttribute<AttributeType, 0, false>;
{% endif %}

    Impl impl_;
};
{% endfor %}

// EVENTS
{% for broadcast in service.broadcasts %}
{% set namePascalCase = broadcast.name | pascalCase %}
class {{ namePascalCase }}Event
{
  public:
    using EventType = {{ broadcast.type | cppType(service.namespace) }};
    using Impl = ::middleware::core::SkeletonEvent<EventType, internal::event_{{ namePascalCase }}_id>;

    explicit {{ namePascalCase }}Event(::middleware::core::SkeletonBase& skeleton) : impl_(skeleton) {}
    {{ namePascalCase }}Event(const {{ namePascalCase }}Event&) = delete;
    {{ namePascalCase }}Event({{ namePascalCase }}Event&&) = delete;
    {{ namePascalCase }}Event& operator=(const {{ namePascalCase }}Event&) = delete;
    {{ namePascalCase }}Event& operator=({{ namePascalCase }}Event&&) = delete;
{% if broadcast.type.name != 'void' %}
    [[nodiscard]] ::middleware::core::HRESULT send(const EventType& data);
{% else %}
    [[nodiscard]] ::middleware::core::HRESULT send();
{% endif %}

  private:
    Impl impl_;
};
{% endfor %}

class {{ service.name }}Skeleton : public ::middleware::core::SkeletonBase
{
    // METHODS
{% for method in service.methods %}
{% if not method.fireAndForget %}
    using {{ method.name | camelCase }}Response =
        ::middleware::core::ResponseBuffer<::middleware::core::ResponseTraits<{{ method.outType | cppType(service.namespace) }}, internal::{{ method.name | camelCase }}_id>, {{ method.deployment.MaxSkeletonRequests }}U>;
{% endif %}
{% endfor %}

  public:
    using Base = ::middleware::core::SkeletonBase;
    using ResponseInfo = middleware::core::ResponseBufferBase::SkeletonResponseInfo;

    {{ service.name }}Skeleton();
    ~{{ service.name }}Skeleton() override;

    {{ service.name }}Skeleton(const {{ service.name }}Skeleton& other) = delete;
    {{ service.name }}Skeleton({{ service.name }}Skeleton&& other) = delete;
    {{ service.name }}Skeleton& operator=(const {{ service.name }}Skeleton& other) = delete;
    {{ service.name }}Skeleton& operator=({{ service.name }}Skeleton&& other) = delete;

    ::middleware::core::HRESULT init(uint16_t const instanceId);
    void deInit();
    bool isInitialized() const override;

    uint16_t getServiceId() const override;

    // METHODS
{% for method in service.methods %}
{% set namePascalCase = method.name | pascalCase %}
{% set nameCamelCase = method.name | camelCase %}
{% if method.fireAndForget %}
    {% if method.inArgs %}
    virtual void {{ nameCamelCase }}(const {{ method.inType | cppType(service.namespace) }}& {{ nameCamelCase }}Input) = 0;
    {% else %}
    virtual void {{ nameCamelCase }}() = 0;
    {% endif %}
{% else %}
    {% if method.inArgs %}
    virtual void {{ nameCamelCase }}(const {{ method.inType | cppType(service.namespace) }}& {{ nameCamelCase }}Input, ResponseInfo& response) = 0;
    {% else %}
    virtual void {{ nameCamelCase }}(ResponseInfo& response) = 0;
    {% endif %}
    {% if method.outArgs %}
    ::middleware::core::HRESULT respond{{ namePascalCase }}(ResponseInfo& response, const {{ method.outType | cppType(service.namespace) }}& {{ nameCamelCase }}Output, const bool handleResponseFailure = true);
    {% else %}
    ::middleware::core::HRESULT respond{{ namePascalCase }}(ResponseInfo& response, const bool handleResponseFailure = true);
    {% endif %}
    ::middleware::core::HRESULT cancel{{ namePascalCase }}Response(ResponseInfo& response);
{% endif %}
{% endfor %}

    // ATTRIBUTES
{% for attribute in service.attributes %}
{% set attributeName = attribute.name | pascalCase %}
    // {{ attributeName }} ATTRIBUTE
    {{ attributeName }}Attribute {{ attributeName | camelCase }};

{% if attribute.hasGetter %}
    virtual void get{{ attributeName }}Attribute(ResponseInfo& response);
    ::middleware::core::HRESULT respondGet{{ attributeName }}Attribute(ResponseInfo& response, const {{ attribute.type | cppType(service.namespace) }}& result, const bool handleResponseFailure = true);
    ::middleware::core::HRESULT cancelGet{{ attributeName }}AttributeResponse(ResponseInfo& response);
{% endif %}
{% if attribute.hasSetter %}
    {% if attribute.deployment.SetterWithResponse %}
    virtual void set{{ attributeName }}Attribute(const {{ attribute.type | cppType(service.namespace) }}& {{ attributeName | camelCase }}, ResponseInfo& response);
    ::middleware::core::HRESULT respondSet{{ attributeName }}Attribute(ResponseInfo& response, const {{ attribute.type | cppType(service.namespace) }}& result, const bool handleResponseFailure = true);
    ::middleware::core::HRESULT cancelSet{{ attributeName }}AttributeResponse(ResponseInfo& response);
    {% else %}
    virtual void set{{ attributeName }}Attribute(const {{ attribute.type | cppType(service.namespace) }}& {{ attributeName | camelCase }});
    {% endif %}
{% endif %}

{%- endfor %}

    // EVENTS
{% for broadcast in service.broadcasts %}
    {{ broadcast.name | pascalCase }}Event {{ broadcast.name | camelCase }};
{% endfor %}

  protected:
    uint32_t getProcessId() const override;
    ::middleware::core::HRESULT onNewMessageReceived(::middleware::core::Message const& msg) override;

  private:
    ::middleware::core::HRESULT sendMessage(::middleware::core::Message& msg) const final;

{% if not mock %}
    // ATTRIBUTES
{% for attribute in service.attributes %}
{% set namePascalCase = attribute.name | pascalCase %}
{% if attribute.hasGetter %}
    using {{ namePascalCase }}GetterResponsePolicy = ::middleware::core::ResponseTraits<{{ namePascalCase }}Attribute::AttributeType, internal::get_{{ namePascalCase }}_id>;
    ::middleware::core::ResponseBuffer<{{ namePascalCase }}GetterResponsePolicy, {{ attribute.deployment.MaxSkeletonRequests }}U> fGet_{{ namePascalCase }}AttributeResponseBuffer;
{% endif %}
{% if attribute.hasSetter and attribute.deployment.SetterWithResponse %}
    using {{ namePascalCase }}SetterResponsePolicy = ::middleware::core::ResponseTraits<{{ namePascalCase }}Attribute::AttributeType, internal::set_{{ namePascalCase }}_id>;
    ::middleware::core::ResponseBuffer<{{ namePascalCase }}SetterResponsePolicy, {{ attribute.deployment.MaxSkeletonRequests }}U> fSet_{{ namePascalCase }}AttributeResponseBuffer;
{% endif %}
{% endfor %}

    // METHODS
{% for method in service.methods %}
{% if not method.fireAndForget %}
    {{ method.name | camelCase }}Response f{{ method.name | camelCase }}ResponseBuffer;
{% endif %}
{% endfor %}
{% endif %}

    uint32_t fProcessId;

    // ALL METHODS
{% for method in service.methods %}
    ::middleware::core::HRESULT {{ method.name | camelCase }}OnNewMessageReceived(const ::middleware::core::Message& msg);
{% endfor %}

    // ATTRIBUTES
{% for attribute in service.attributes %}
{% if attribute.hasGetter %}
    ::middleware::core::HRESULT get{{ attribute.name | pascalCase }}AttributeOnNewMessageReceived(const ::middleware::core::Message& msg);
{% endif %}
{% if attribute.hasSetter %}
    ::middleware::core::HRESULT set{{ attribute.name | pascalCase }}AttributeOnNewMessageReceived(const ::middleware::core::Message& msg);
{% endif %}
{% endfor %}
};

}  // namespace {{ service.namespace | lower }}::{{ service.name }}::skeleton
