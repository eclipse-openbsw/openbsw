{% from "macros/common.jinja" import file_header %}{{ file_header() }}
#pragma once

#include <etl/delegate.h>
#include <etl/expected.h>

#include "{{ service.commonInclude }}"
#include "middleware/rpc/ProxyMethod.h"

namespace {{ service.namespace | lower }}::{{ service.name }}::proxy
{

class {{ service.name }}Proxy;

// EVENTS
{% for broadcast in service.broadcasts %}
{% set namePascalCase = broadcast.name | pascalCase %}
class {{ namePascalCase }}Event
{
    using Impl = ::middleware::core::ProxyEventBase<{{ service.name }}Proxy, {{ broadcast.type | cppType(service.namespace) }}>;

  public:
    using EventType = {{ broadcast.type | cppType(service.namespace) }};
    using OnFieldChangedCallback = Impl::OnFieldChangedCallback;

    explicit {{ namePascalCase }}Event(::middleware::core::ProxyBase& proxy);
    ~{{ namePascalCase }}Event() = default;
    {{ namePascalCase }}Event(const {{ namePascalCase }}Event&) = delete;
    {{ namePascalCase }}Event({{ namePascalCase }}Event&&) = delete;
    {{ namePascalCase }}Event& operator=(const {{ namePascalCase }}Event&) = delete;
    {{ namePascalCase }}Event& operator=({{ namePascalCase }}Event&&) = delete;

    void setReceiveHandler(const OnFieldChangedCallback callback);
    void unsetReceiveHandler();

  private:
    friend class {{ service.name }}Proxy;

    Impl impl_;
};
{% endfor %}

// ATTRIBUTES
{% for attribute in service.attributes %}
{% set namePascalCase = attribute.name | pascalCase %}
{%- set _has_subscription = attribute.hasNotifier %}
{%- set _has_setter = attribute.hasSetter %}
{%- set _set_as_method = attribute.deployment.SetterWithResponse and attribute.hasSetter %}
{%- set _attribute_type = "FullyFeatured" %}
{%- if not attribute.hasSetter and not attribute.hasNotifier %}
    {%- set _attribute_type = "ReadOnly_NoSubscription" %}
{%- elif not attribute.hasSetter %}
    {%- set _attribute_type = "ReadOnly" %}
{%- elif not attribute.hasNotifier and attribute.deployment.SetterWithResponse %}
    {%- set _attribute_type = "NoSubscriptions_SetAsMethod" %}
{%- elif not attribute.hasNotifier %}
    {%- set _attribute_type = "NoSubscriptions" %}
{%- elif attribute.deployment.SetterWithResponse %}
    {%- set _attribute_type = "FullyFeatured_SetAsMethod" %}
{%- endif %}

class {{ namePascalCase }}Attribute
{
    using GetterTraits =
        middleware::rpc::MethodTraits<void, {{ attribute.type | cppType(service.namespace) }}, {{ attribute.deployment.Timeout }}U>;
{% if attribute.deployment.SetterWithResponse and attribute.deployment.SetterID is not none %}
    using SetterTraits =
        middleware::rpc::MethodTraits<{{ attribute.type | cppType(service.namespace) }}, {{ attribute.type | cppType(service.namespace) }}, {{ attribute.deployment.Timeout }}U>;
{% else %}
    using SetterTraits = void;
{% endif %}
    using Impl = ::middleware::core::ProxyAttribute<{{ service.name }}Proxy,
                                                    GetterTraits,
                                                    SetterTraits,
                                                    ::middleware::core::AttributeType::{{ _attribute_type }},
                                                    {{ attribute.type | cppType(service.namespace) }}>;
  public:
    using AttributeType = {{ attribute.type | cppType(service.namespace) }};

    using GetterResult = typename Impl::GetterResult;
    using GetterCallback = typename Impl::GetterCallback;
{%- if _has_subscription %}
    using OnFieldChangedCallback = typename Impl::OnFieldChangedCallback;
{%- endif %}
{%- if _set_as_method %}
    using SetterResult = typename Impl::SetterResult;
    using SetterCallback = typename Impl::SetterCallback;
{%- endif %}

    explicit {{ namePascalCase }}Attribute(::middleware::core::ProxyBase& proxy);
    ~{{ namePascalCase }}Attribute() = default;
    {{ namePascalCase }}Attribute(const {{ namePascalCase }}Attribute&) = delete;
    {{ namePascalCase }}Attribute({{ namePascalCase }}Attribute&&) = delete;
    {{ namePascalCase }}Attribute& operator=(const {{ namePascalCase }}Attribute&) = delete;
    {{ namePascalCase }}Attribute& operator=({{ namePascalCase }}Attribute&&) = delete;

    ::etl::expected<uint16_t, ::middleware::core::HRESULT> get(const GetterCallback attrCb);
    ::middleware::core::HRESULT cancelGetterRequest(uint16_t requestId);
{%- if _set_as_method %}
    ::etl::expected<uint16_t, ::middleware::core::HRESULT> set(AttributeType const& payload, SetterCallback const cbk);
    ::middleware::core::HRESULT cancelSetterRequest(uint16_t requestId);
{%- elif _has_setter %}
    ::etl::expected<uint16_t, ::middleware::core::HRESULT> set(AttributeType const& payload);
{%- endif %}
{%- if _has_subscription %}
    void setReceiveHandler(const OnFieldChangedCallback callback);
    void unsetReceiveHandler();
{%- endif %}

  private:
    friend class {{ service.name }}Proxy;

    Impl impl_;
};

{% endfor %}

class {{ service.name }}Proxy : public middleware::core::ProxyBase, public middleware::core::ITimeoutHandler
{
    // METHODS
{% for method in service.methods %}
{% if not method.fireAndForget %}
using {{ method.name }}MethodTraits =
{% if method.outArgs %}
    middleware::rpc::MethodTraits<{{ method.inType | cppType(service.namespace) }}, {{ method.outType | cppType(service.namespace) }}, {{ method.deployment.Timeout }}U>;
{% else %}
    middleware::rpc::MethodTraits<{{ method.inType | cppType(service.namespace) }}, void, {{ method.deployment.Timeout }}U>;
{% endif %}
    using {{ method.name }}Method = middleware::rpc::ProxyMethod<{{ method.name }}MethodTraits, {{ method.deployment.MaxProxyRequests }}U>;
{% endif %}
{% endfor %}

  public:
    using Base = middleware::core::ProxyBase;

    // METHODS
{% for method in service.methods %}
{% if not method.fireAndForget %}
    using {{ method.name }}Result   = {{ method.name }}Method::Result;
    using {{ method.name }}Callback = {{ method.name }}Method::Callback;
{% endif %}
{% endfor %}

    {{ service.name }}Proxy();
    ~{{ service.name }}Proxy() override;

    {{ service.name }}Proxy(const {{ service.name }}Proxy& other) = delete;
    {{ service.name }}Proxy({{ service.name }}Proxy&& other) = delete;
    {{ service.name }}Proxy& operator=(const {{ service.name }}Proxy& other) = delete;
    {{ service.name }}Proxy& operator=({{ service.name }}Proxy&& other) = delete;


    middleware::core::HRESULT init(const internal::InstanceId instanceId,
                                   ::middleware::core::ClusterId const sourceCluster);
    void deInit();
    bool isInitialized() const override;
    uint16_t getServiceId() const override;

    // METHODS FIRE_AND_FORGET
{% for method in service.methods %}
{% if method.fireAndForget %}
{% if method.inArgs %}
    etl::expected<uint16_t, middleware::core::HRESULT> {{ method.name | camelCase }}(const {{ method.inType | cppType(service.namespace) }}&);
{% else %}
    etl::expected<uint16_t, middleware::core::HRESULT> {{ method.name | camelCase }}();
{% endif %}
{% endif %}
{% endfor %}

    // METHODS
{% for method in service.methods %}
{% if not method.fireAndForget %}
{% if method.inArgs %}
    etl::expected<uint16_t, middleware::core::HRESULT> {{ method.name | camelCase }}(const {{ method.inType | cppType(service.namespace) }}&, const {{ method.name }}Callback);
{% else %}
    etl::expected<uint16_t, middleware::core::HRESULT> {{ method.name | camelCase }}(const {{ method.name }}Callback);
{% endif %}
    void cancel{{ method.name }}Request(uint16_t requestId);
{% endif %}

{% endfor %}

    // ATTRIBUTES
{% for attribute in service.attributes %}
    {{ attribute.name | pascalCase }}Attribute {{ attribute.name | camelCase }};
{% endfor %}

    // EVENTS
{% for broadcast in service.broadcasts %}
    {{ broadcast.name | pascalCase }}Event {{ broadcast.name | camelCase }};
{% endfor %}

  protected:
    uint32_t fProcessId;
    middleware::core::HRESULT onNewMessageReceived(::middleware::core::Message const& msg) override;

  private:
    void futureDispatcherDeinitialization();
    void unsetNotificationHandlers();
    void updateTimeouts() override;
    void doUpdateTimeouts();
    middleware::core::HRESULT sendMessage(::middleware::core::Message& msg) const final;

    // METHODS
{% for method in service.methods %}
{% if not method.fireAndForget %}
    {{ method.name }}Method {{ method.name | camelCase }}Method_;
{% endif %}
{% endfor %}
};

}  // namespace {{ service.namespace | lower }}::{{ service.name }}::proxy
