{
}

{{ service.name }}Skeleton::~{{ service.name }}Skeleton()
{
    deInit();
}

middleware::core::HRESULT {{ service.name }}Skeleton::init(uint16_t const instanceId)
{
    auto const db = internal::getClusterConnectionsDb();
    const auto ret = Base::initFromInstancesDatabase(static_cast<uint16_t>(instanceId), db);
    if (Base::isInitialized())
    {
        fProcessId = middleware::os::getProcessId();
    }

    return ret;
}

void {{ service.name }}Skeleton::deInit()
{
    Base::checkCrossThreadError(fProcessId);
    Base::unsubscribe(internal::SERVICE_ID);
}

bool {{ service.name }}Skeleton::isInitialized() const
{
    return Base::isInitialized();
}

uint16_t {{ service.name }}Skeleton::getServiceId() const
{
    return internal::SERVICE_ID;
}

middleware::core::HRESULT {{ service.name }}Skeleton::onNewMessageReceived(middleware::core::Message const& msg)
{
    middleware::core::HRESULT ret = middleware::core::HRESULT::ServiceMemberIdNotFound;
    Base::checkCrossThreadError(fProcessId);
    switch (msg.getHeader().memberId)
    {
        // METHODS FIRE_AND_FORGET
{% for method in service.methods %}
{% if method.fireAndForget %}
        case internal::{{ method.name | camelCase }}_id: {
            ret = {{ method.name | camelCase }}OnNewMessageReceived(msg);
            break;
        }
{% endif %}
{% endfor %}
        // ATTRIBUTES
{% for attribute in service.attributes %}
{% set namePascalCase = attribute.name | pascalCase %}
{% if attribute.hasGetter %}
        case internal::get_{{ namePascalCase }}_id: {
            ret = get{{ namePascalCase }}AttributeOnNewMessageReceived(msg);
            break;
        }
{% endif %}
{% if attribute.hasSetter %}
        case internal::set_{{ namePascalCase }}_id: {
            ret = set{{ namePascalCase }}AttributeOnNewMessageReceived(msg);
            break;
        }
{% endif %}
{% endfor %}
        // METHODS
{% for method in service.methods %}
{% if not method.fireAndForget %}
        case internal::{{ method.name | camelCase }}_id: {
            ret = {{ method.name | camelCase }}OnNewMessageReceived(msg);
            break;
        }
{% endif %}
{% endfor %}
        default: {
            if (msg.isError() && msg.isEvent())
            {
                middleware::logger::logMessageSendingFailure(
                    middleware::logger::LogLevel::Error, middleware::logger::Error::DispatchMessage, ret, msg);
                ret = middleware::core::HRESULT::Ok;
            }
            break;
        }
    }
    return ret;
}

// METHODS
{% for method in service.methods %}
middleware::core::HRESULT {{ service.name }}Skeleton::{{ method.name | camelCase }}OnNewMessageReceived(const middleware::core::Message& msg)
{
{% if method.fireAndForget %}
    {% if method.inArgs %}
    const auto payload = middleware::core::MessagePayloadBuilder::getInstance().readPayload<{{ method.inType | cppType(service.namespace) }}>(msg);
    {{ method.name | camelCase }}(payload);
    {% else %}
    static_cast<void>(msg);
    {{ method.name | camelCase }}();
    {% endif %}
{% else %}
    ResponseInfo* response =
        f{{ method.name | camelCase }}ResponseBuffer.getAvailableResponse(
            msg.getHeader().addressId, msg.getHeader().srcClusterId, msg.getHeader().requestId);

    if (response == nullptr)
    {
        return middleware::core::HRESULT::ServiceBusy;
    }
    {% if method.inArgs %}
    const auto payload = middleware::core::MessagePayloadBuilder::getInstance().readPayload<{{ method.inType | cppType(service.namespace) }}>(msg);
    {{ method.name | camelCase }}(payload, *response);
    {% else %}
    {{ method.name | camelCase }}(*response);
    {% endif %}
{% endif %}

    return middleware::core::HRESULT::Ok;
}

{% if not method.fireAndForget %}

{% if method.outArgs %}
middleware::core::HRESULT {{ service.name }}Skeleton::respond{{ method.name | pascalCase }}(ResponseInfo& response, const {{ method.outType | cppType(service.namespace) }}& {{ method.name | camelCase }}Output, const bool handleResponseFailure)
{
    return f{{ method.name | camelCase }}ResponseBuffer.respond(response, {{ method.name | camelCase }}Output, handleResponseFailure);
}
{% else %}
middleware::core::HRESULT {{ service.name }}Skeleton::respond{{ method.name | pascalCase }}(ResponseInfo& response, const bool handleResponseFailure)
{
    return f{{ method.name | camelCase }}ResponseBuffer.respond(response, handleResponseFailure);
}
{% endif %}

middleware::core::HRESULT {{ service.name }}Skeleton::cancel{{ method.name | pascalCase }}Response(ResponseInfo& response)
{
