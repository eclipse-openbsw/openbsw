{% if attribute.hasGetter %}
middleware::core::HRESULT {{ service.name }}Skeleton::get{{ namePascalCase }}AttributeOnNewMessageReceived(const middleware::core::Message& msg)
{
    middleware::core::HRESULT ret = middleware::core::HRESULT::ServiceBusy;

    const auto response = fGet_{{ namePascalCase }}AttributeResponseBuffer.getAvailableResponse(
        msg.getHeader().addressId, msg.getHeader().srcClusterId, msg.getHeader().requestId);
    if (response != nullptr)
    {
        get{{ namePascalCase }}Attribute(*response);
        ret = middleware::core::HRESULT::Ok;
    }

    return ret;
}
{% endif %}
{% if attribute.hasSetter %}
    {% if attribute.deployment.SetterWithResponse %}
middleware::core::HRESULT {{ service.name }}Skeleton::set{{ namePascalCase }}AttributeOnNewMessageReceived(const middleware::core::Message& msg)
{
    middleware::core::HRESULT ret = middleware::core::HRESULT::ServiceBusy;

    const auto response = fSet_{{ namePascalCase }}AttributeResponseBuffer.getAvailableResponse(
        msg.getHeader().addressId, msg.getHeader().srcClusterId, msg.getHeader().requestId);
    if (response != nullptr)
    {
        const auto payload = middleware::core::MessagePayloadBuilder::getInstance().readPayload<{{ attribute.type | cppType(service.namespace) }}>(msg);
        set{{ namePascalCase }}Attribute(payload, *response);
        ret = middleware::core::HRESULT::Ok;
    }

    return ret;
}
    {% else %}
middleware::core::HRESULT {{ service.name }}Skeleton::set{{ namePascalCase }}AttributeOnNewMessageReceived(const middleware::core::Message& msg)
{
    const auto payload = middleware::core::MessagePayloadBuilder::getInstance().readPayload<{{ attribute.type | cppType(service.namespace) }}>(msg);
    set{{ namePascalCase }}Attribute(payload);

    return middleware::core::HRESULT::Ok;
}
    {% endif %}
{% endif %}
