{% macro cluster_connection_meta(connection) %}
class ClusterConnection{{ connection.sourceCluster.name }}To{{ connection.targetCluster.name }}Meta : public core::IClusterConnectionConfiguration
{
public:
    using Base = core::IClusterConnectionConfiguration;

    ClusterConnection{{ connection.sourceCluster.name }}To{{ connection.targetCluster.name }}Meta()
{% if (connection.consumers | length > 0) and (connection.providers | length > 0) %}
    : proxyTransceivers_{ {
    {% for consumer in connection.consumers | sort(attribute='deployment.ServiceID') %}
                {&{{ consumer.namespace | replace("::", "") | lower }}{{ consumer.name }}ProxyTransceivers_, {{ consumer.namespace | lower }}::{{ consumer.name }}::internal::SERVICE_ID, 0U}{{ "," if not loop.last }}
    {% endfor %}
    } },
    skeletonTransceivers_{ {
    {% for provider in connection.providers | sort(attribute='deployment.ServiceID') %}
                {&{{ provider.namespace | replace("::", "") | lower }}{{ provider.name }}SkeletonTransceivers_, {{ provider.namespace | lower }}::{{ provider.name }}::internal::SERVICE_ID, 0U}{{ "," if not loop.last }}
    {% endfor %}
            } }
{% elif connection.consumers | length > 0 %}
        : proxyTransceivers_{ {
    {% for consumer in connection.consumers | sort(attribute='deployment.ServiceID') %}
                {&{{ consumer.namespace | replace("::", "") | lower }}{{ consumer.name }}ProxyTransceivers_, {{ consumer.namespace | lower }}::{{ consumer.name }}::internal::SERVICE_ID, 0U}{{ "," if not loop.last }}
    {% endfor %}
            } }
{% else %}
        : skeletonTransceivers_{ {
    {% for provider in connection.providers | sort(attribute='deployment.ServiceID') %}
                {&{{ provider.namespace | replace("::", "") | lower }}{{ provider.name }}SkeletonTransceivers_, {{ provider.namespace | lower }}::{{ provider.name }}::internal::SERVICE_ID, 0U}{{ "," if not loop.last }}
    {% endfor %}
    } }
{% endif %}
    {
    }

    ClusterConnection{{ connection.sourceCluster.name }}To{{ connection.targetCluster.name }}Meta(const ClusterConnection{{ connection.sourceCluster.name }}To{{ connection.targetCluster.name }}Meta&) = delete;
    ClusterConnection{{ connection.sourceCluster.name }}To{{ connection.targetCluster.name }}Meta& operator=(const ClusterConnection{{ connection.sourceCluster.name }}To{{ connection.targetCluster.name }}Meta&) = delete;
    ClusterConnection{{ connection.sourceCluster.name }}To{{ connection.targetCluster.name }}Meta& operator=(ClusterConnection{{ connection.sourceCluster.name }}To{{ connection.targetCluster.name }}Meta&&) = delete;
    ClusterConnection{{ connection.sourceCluster.name }}To{{ connection.targetCluster.name }}Meta(ClusterConnection{{ connection.sourceCluster.name }}To{{ connection.targetCluster.name }}Meta&&) = delete;

    [[nodiscard]] uint8_t getSourceClusterId() const final { return etl::to_underlying(core::ClusterId::{{ connection.sourceCluster.name }}); }

    [[nodiscard]] uint8_t getTargetClusterId() const final { return etl::to_underlying(core::ClusterId::{{ connection.targetCluster.name }}); }

    [[nodiscard]] bool write(const core::Message& msg) const final
    {
        etl::remove_pointer<decltype(::middleware::shm::getQueueTo{{ connection.targetCluster.name }}())>::type::Sender sender(*::middleware::shm::getQueueTo{{ connection.targetCluster.name }}());
        return sender.write(msg);
    }

    [[nodiscard]] size_t registeredTransceiversCount(uint16_t serviceId) const final
    {
{% if (connection.consumers | length > 0) and (connection.providers | length > 0) %}
        return core::meta::DbManipulator::registeredTransceiversCount(
                   proxyTransceivers_.begin(), proxyTransceivers_.end(), serviceId) +
               core::meta::DbManipulator::registeredTransceiversCount(
                   skeletonTransceivers_.begin(), skeletonTransceivers_.end(), serviceId);
{% elif connection.consumers | length > 0 %}
        return core::meta::DbManipulator::registeredTransceiversCount(
            proxyTransceivers_.begin(), proxyTransceivers_.end(), serviceId);
{% else %}
        return core::meta::DbManipulator::registeredTransceiversCount(
            skeletonTransceivers_.begin(), skeletonTransceivers_.end(), serviceId);
{% endif %}
    }

    [[nodiscard]] core::HRESULT dispatchMessage(const core::Message& msg) const final
    {
{% if (connection.consumers | length > 0) and (connection.providers | length > 0) %}
    return IClusterConnectionConfigurationBase::dispatchMessage(proxyTransceivers_.begin(),
                    proxyTransceivers_.end(),
                    skeletonTransceivers_.begin(),
                    skeletonTransceivers_.end(),
                                                                    msg);
{% elif connection.consumers | length > 0 %}
        return IClusterConnectionConfigurationBase::dispatchMessageToProxy(
        proxyTransceivers_.begin(), proxyTransceivers_.end(), msg);
{% else %}
        return IClusterConnectionConfigurationBase::dispatchMessageToSkeleton(
        skeletonTransceivers_.begin(), skeletonTransceivers_.end(), msg);
{% endif %}
    }

{% if connection.consumers | length > 0 %}
    void registerTimeoutTransceiver(core::ITimeoutHandler& transceiver) final
    {
        core::ITimeoutConfiguration::registerTimeoutTransceiver(transceiver, timeoutTransceivers_);
    }
{% else %}
    void registerTimeoutTransceiver(core::ITimeoutHandler&) final
    {
    }
{% endif %}

{% if connection.consumers | length > 0 %}
    void unregisterTimeoutTransceiver(core::ITimeoutHandler& transceiver) final
    {
        core::ITimeoutConfiguration::unregisterTimeoutTransceiver(transceiver, timeoutTransceivers_);
    }
{% else %}
    void unregisterTimeoutTransceiver(core::ITimeoutHandler&) final
    {
    }
{% endif %}

    void updateTimeouts() final
    {
{% if connection.consumers | length > 0 %}
        core::ITimeoutConfiguration::updateTimeouts(timeoutTransceivers_);
{% endif %}
    }

    [[nodiscard]] core::HRESULT subscribe(core::ProxyBase& proxy, uint16_t serviceInstanceId) final
    {
{% if connection.consumers | length > 0 %}
        return core::meta::DbManipulator::subscribe(
            proxyTransceivers_.begin(), proxyTransceivers_.end(), proxy, serviceInstanceId);
{% else %}
        static_cast<void>(proxy);
        static_cast<void>(serviceInstanceId);
        return core::HRESULT::NotImplemented;
{% endif %}
    }

    void unsubscribe(core::ProxyBase& proxy, uint16_t serviceId) final
    {
{% if connection.consumers | length > 0 %}
        core::meta::DbManipulator::unsubscribe(
            proxyTransceivers_.begin(), proxyTransceivers_.end(), proxy, serviceId);
{% else %}
        static_cast<void>(proxy);
        static_cast<void>(serviceId);
{% endif %}
    }

    [[nodiscard]] core::HRESULT subscribe(core::SkeletonBase& skeleton, uint16_t serviceInstanceId) final
    {
{% if connection.providers | length > 0 %}
        return core::meta::DbManipulator::subscribe(
            skeletonTransceivers_.begin(), skeletonTransceivers_.end(), skeleton, serviceInstanceId);
{% else %}
        static_cast<void>(skeleton);
        static_cast<void>(serviceInstanceId);
        return core::HRESULT::NotImplemented;
{% endif %}
    }

    void unsubscribe(core::SkeletonBase& skeleton, uint16_t serviceId) final
    {
{% if connection.providers | length > 0 %}
        core::meta::DbManipulator::unsubscribe(
            skeletonTransceivers_.begin(), skeletonTransceivers_.end(), skeleton, serviceId);
{% else %}
        static_cast<void>(skeleton);
        static_cast<void>(serviceId);
{% endif %}
    }

    ~ClusterConnection{{ connection.sourceCluster.name }}To{{ connection.targetCluster.name }}Meta() = default;

  private:
    {% for consumer in connection.consumers %}
    etl::vector<core::TransceiverBase*, {{ consumer.maxInstances }}U> {{ consumer.namespace | replace("::", "") | lower }}{{ consumer.name }}ProxyTransceivers_;
    {% endfor %}
    {% for provider in connection.providers %}
    etl::vector<core::TransceiverBase*, {{ provider.maxInstances }}U> {{ provider.namespace | replace("::", "") | lower }}{{ provider.name }}SkeletonTransceivers_;
    {% endfor %}
    {% if connection.consumers | length > 0 %}
    etl::vector<core::ITimeoutHandler*, {{ connection.consumers | sum(attribute='maxInstances') }}U> timeoutTransceivers_;
    {% endif %}
    {% if connection.consumers | length > 0 %}
    etl::array<core::meta::TransceiverContainer, {{ connection.consumers | length }}U> proxyTransceivers_;
    {% endif %}
    {% if connection.providers | length > 0 %}
    etl::array<core::meta::TransceiverContainer, {{ connection.providers | length }}U> skeletonTransceivers_;
    {% endif %}
};
{% endmacro %}
