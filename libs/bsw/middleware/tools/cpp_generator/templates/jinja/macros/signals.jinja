  Resolves C++ types and bit-stream read/write expressions for PDU signals,
  covering plain integrals as well as the 'array' / 'bitset' / enum signal kinds.
-#}
{%- set _INTEGRAL_BITS = {
    "bool": 1,
    "uint8_t": 8,
    "uint16_t": 16,
    "uint32_t": 32,
    "uint64_t": 64,
} -%}

{#- Underlying integral type of signal.type when it names a PDU-local enum, else empty. -#}
{%- macro _enum_underlying_type(signal, pdu) -%}
{%- for enum_type in (pdu.enums if pdu.enums else []) -%}
{%- if enum_type.name == signal.type -%}{{ enum_type.type }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{#- Underlying integral type of signal.type when it names a PDU-local bitset, else empty. -#}
{%- macro _bitset_underlying_type(signal, pdu) -%}
{%- for bitset in (pdu.bitsets if pdu.bitsets else []) -%}
{%- if bitset.name == signal.type -%}{{ bitset.type }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}

{%- macro signal_cpp_type(signal) -%}
{%- if signal.type == "array" -%}
etl::array<{{ signal.element_type }}, {{ signal.bit_length // _INTEGRAL_BITS[signal.element_type] }}U>
{%- else -%}
{{ signal.type }}
{%- endif -%}
{%- endmacro -%}

{#- Parameter declaration of a signal setter; arrays and bitsets are passed by reference. -#}
{%- macro signal_param(signal, pdu) -%}
{%- set is_bitset = (pdu.bitsets if pdu.bitsets else []) | selectattr("name", "equalto", signal.type) | list | length > 0 -%}
const {{ signal_cpp_type(signal) }}{{ "&" if signal.type == "array" or is_bitset }} value
{%- endmacro -%}

{#- One statement appending 'source' to the bit_stream_writer named 'stream'. -#}
{%- macro signal_write_stmt(signal, pdu, source) -%}
::middleware::core::codec::writeSignal<{{ signal.bit_length }}U>(stream, {{ source }});
{%- endmacro -%}

{%- macro _unsigned_all_ones_expr(signal, underlying_type) -%}
{%- if signal.bit_length == _INTEGRAL_BITS[underlying_type] -%}
etl::numeric_limits<{{ underlying_type }}>::max()
{%- else -%}
static_cast<{{ underlying_type }}>(etl::numeric_limits<{{ underlying_type }}>::max() >> {{ _INTEGRAL_BITS[underlying_type] - signal.bit_length }}U)
{%- endif -%}
{%- endmacro -%}

{#- Default writer value of a signal: all bits within its wire width are set. -#}
{%- macro signal_all_ones_expr(signal, pdu) -%}
{%- if signal.type == "array" -%}
{{ signal_cpp_type(signal) }}{ {% for _ in range(signal.bit_length // _INTEGRAL_BITS[signal.element_type]) %}etl::numeric_limits<{{ signal.element_type }}>::max(){{ "," if not loop.last }}{% endfor %} }
{%- elif _bitset_underlying_type(signal, pdu) -%}
{{ signal.type }}({{ _unsigned_all_ones_expr(signal, _bitset_underlying_type(signal, pdu)) }})
{%- elif _enum_underlying_type(signal, pdu) -%}
static_cast<{{ signal.type }}>({{ _unsigned_all_ones_expr(signal, _enum_underlying_type(signal, pdu)) }})
{%- elif signal.type == "bool" -%}
true
{%- else -%}
{{ _unsigned_all_ones_expr(signal, signal.type) }}
{%- endif -%}
{%- endmacro -%}

{%- macro signal_read_expr(signal, pdu) -%}
::middleware::core::codec::readSignal<{{ signal_cpp_type(signal) }}, {{ signal.bit_length }}U>(reader)
{%- endmacro -%}
