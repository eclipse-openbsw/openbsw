load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel/config/build_variant:compatibility.bzl", "unit_test_only")

cc_library(
    name = "async_impl",
    hdrs = [
        "include/async/EventDispatcher.h",
        "include/async/EventPolicy.h",
        "include/async/IRunnable.h",
        "include/async/Queue.h",
        "include/async/QueueNode.h",
        "include/async/RunnableExecutor.h",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/3rdparty/etl",
    ],
)

cc_library(
    name = "async_impl_mock",
    hdrs = [
        "mock/include/async/RunnableMock.h",
    ],
    strip_include_prefix = "mock/include",
    target_compatible_with = unit_test_only(),
    visibility = ["//visibility:public"],
    deps = [
        "//libs/3rdparty/googletest:gtest",
        "//libs/bsw/asyncImpl:async_impl",
    ],
)
