load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel/config/build_variant:compatibility.bzl", "unit_test_only")

cc_library(
    name = "io",
    srcs = [
        "src/io/BufferedWriter.cpp",
    ],
    hdrs = [
        "include/io/BufferedWriter.h",
        "include/io/ForwardingReader.h",
        "include/io/IReader.h",
        "include/io/IWriter.h",
        "include/io/JoinReader.h",
        "include/io/MemoryQueue.h",
        "include/io/SplitWriter.h",
        "include/io/VariantQueue.h",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/3rdparty/etl",
        "//libs/bsw/util",
    ],
)

cc_library(
    name = "io_mock",
    hdrs = [
        "mock/include/io/IReaderMock.h",
        "mock/include/io/IWriterMock.h",
    ],
    strip_include_prefix = "mock/include",
    target_compatible_with = unit_test_only(),
    visibility = ["//visibility:public"],
    deps = [
        ":io",
        "//libs/3rdparty/etl",
        "//libs/3rdparty/googletest:gtest_main",
    ],
)

cc_test(
    name = "io_test",
    srcs = [
        "test/src/io/BufferedWriterTest.cpp",
        "test/src/io/ForwardingReaderTest.cpp",
        "test/src/io/JoinReaderTest.cpp",
        "test/src/io/MemoryQueueTest.cpp",
        "test/src/io/SplitWriterTest.cpp",
        "test/src/io/VariantQueueTest.cpp",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//libs/3rdparty/googletest:gtest_main",
        "//libs/bsw/io",
        "//libs/bsw/io:io_mock",
        "//libs/bsw/util:util_mock",
    ],
)
