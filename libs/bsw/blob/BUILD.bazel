load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel/config/build_variant:compatibility.bzl", "unit_test_only")
load("//tools/blob:routing.bzl", "generate_routing")

generate_routing(
    name = "generated_routing_headers",
    jsonl = "test/routing.jsonl",
    visibility = ["//visibility:public"],
)

exports_files([
    "test/routing.jsonl",
])

# Override via --//libs/bsw/blob:blob_configuration=<your_blob_config_target>
label_flag(
    name = "blob_configuration",
    build_setting_default = "//bazel/config:no_implementation",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "blob",
    srcs = [
        "src/blob/Blob.cpp",
        "src/blob/Config.cpp",
        "src/blob/Header.cpp",
        "src/blob/Logger.cpp",
        "src/blob/util.cpp",
    ],
    hdrs = [
        "include/blob/Blob.h",
        "include/blob/Config.h",
        "include/blob/Header.h",
        "include/blob/Logger.h",
        "include/blob/util.h",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":blob_configuration",
        "//libs/3rdparty/etl",
        "//libs/bsw/util",
    ],
)

# Provides generated blob/routing headers for blob unit-test build settings.
cc_library(
    name = "blob_test_config_type",
    target_compatible_with = unit_test_only(),
    visibility = ["//visibility:public"],
    deps = [":generated_routing_headers"],
)

# Provides generated CONFIGURATION_BLOB data used by blob unit tests.
cc_library(
    name = "blob_test_configuration",
    target_compatible_with = unit_test_only(),
    visibility = ["//visibility:public"],
    deps = [":generated_routing_headers"],
)

cc_test(
    name = "blob_test",
    srcs = [
        "test/src/BlobTest.cpp",
    ],
    target_compatible_with = unit_test_only(),
    visibility = ["//visibility:public"],
    deps = [
        ":blob_test_configuration",
        "//libs/3rdparty/googletest:gtest_main",
        "//libs/bsw/blob",
        "//libs/bsw/util:util_mock",
    ],
)
