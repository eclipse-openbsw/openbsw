load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel/config/build_variant:compatibility.bzl", "unit_test_only")

cc_library(
    name = "cpp2someip_headers",
    hdrs = glob(["include/**/*.h"]),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/3rdparty/etl",
        "//libs/bsw/async:async_headers",
        "//libs/bsw/async:async_platform",
        "//libs/bsw/cpp2ethernet",
        "//libs/bsw/util",
    ],
)

cc_library(
    name = "cpp2someip",
    srcs = glob(["src/**/*.cpp"]),
    visibility = ["//visibility:public"],
    deps = [
        ":cpp2someip_headers",
    ],
)

cc_library(
    name = "cpp2someip_mock",
    hdrs = glob(["mock/include/**/*.h"]),
    strip_include_prefix = "mock/include",
    target_compatible_with = unit_test_only(),
    visibility = ["//visibility:public"],
    deps =
        [
            ":cpp2someip_headers",
            "//libs/3rdparty/googletest:gtest",
        ],
)

cc_test(
    name = "cpp2someip_test",
    srcs = glob([
        "test/src/*.cpp",
        "test/src/*.h",
    ]),
    target_compatible_with = unit_test_only(),
    visibility = ["//visibility:public"],
    deps = [
        "//executables/unitTest/common:ut_common",
        "//libs/3rdparty/googletest:gtest_esr_extensions",
        "//libs/3rdparty/googletest:gtest_main",
        "//libs/bsw/async:async_mock_impl",
        "//libs/bsw/bsp:bsp_mock",
        "//libs/bsw/cpp2ethernet:cpp2ethernet_mock",
        "//libs/bsw/cpp2someip",
        "//libs/bsw/cpp2someip:cpp2someip_mock",
        "//libs/bsw/util:util_mock",
    ],
)
