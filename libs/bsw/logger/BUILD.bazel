load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "logger",
    srcs = [
        "src/logger/DefaultLoggerCommand.cpp",
        "src/logger/EntrySerializer.cpp",
    ],
    hdrs = glob(["include/**/*.h"]),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/bsw/util",
    ],
)

cc_library(
    name = "logger_mock",
    testonly = True,
    hdrs = [
        "mock/include/logger/PersistenceManagerMock.h",
    ],
    strip_include_prefix = "mock/include",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/3rdparty/googletest:gtest_main",
        "//libs/bsw/bsp:bsp_mock",
        "//libs/bsw/logger",
        "//libs/bsw/util:util_mock",
    ],
)
