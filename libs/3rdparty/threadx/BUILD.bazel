load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Override via --//libs/3rdparty/threadx:threadx_port_headers=<your_port_headers_target>
label_flag(
    name = "threadx_port_headers",
    build_setting_default = "//bazel/config:no_implementation",
    visibility = ["//visibility:public"],
)

# Override via --//libs/3rdparty/threadx:threadx_port_impl=<your_port_impl_target>
label_flag(
    name = "threadx_port_impl",
    build_setting_default = "//bazel/config:no_implementation",
    visibility = ["//visibility:public"],
)

# Override via --//libs/3rdparty/threadx:threadx_os_hooks=<your_os_hooks_target>
label_flag(
    name = "threadx_os_hooks",
    build_setting_default = "//bazel/config:no_implementation",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "threadx_headers",
    hdrs = glob(["common/inc/**/*.h"]),
    includes = ["common/inc"],
    visibility = ["//visibility:public"],
    deps = [
        ":threadx_port_headers",
        "//libs/bsw/asyncThreadX:threadx_configuration",
    ],
)

# Circular dependency present on the CMake side: threadX -> osHooks -> asyncThreadX -> threadX
# Split off threadx_headers to break the circular dependency for Bazel
cc_library(
    name = "threadx",
    srcs = glob(["common/src/*.c"]),
    copts = ["-Wno-error=unused-parameter"],
    implementation_deps = [
        ":threadx_os_hooks",
        ":threadx_port_impl",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":threadx_headers",
    ],
    # CMake declares mutual static-library dependencies between threadX core and its port
    # resolved by archive repetition. Bazel links each archive once. Force-linking ensures
    # _tx_execution_initialize is available when threadX core's force-linked objects create the
    # dependency at link time.
    alwayslink = True,
)
