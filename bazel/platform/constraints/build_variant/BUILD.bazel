# Separates production firmware builds from unit-test builds. Mock libs and
# test targets declare incompatibility with reference_app so wildcard builds
# skip them on production platforms.

constraint_setting(
    name = "build_variant",
    default_constraint_value = ":reference_app",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "reference_app",
    constraint_setting = ":build_variant",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "unit_test",
    constraint_setting = ":build_variant",
    visibility = ["//visibility:public"],
)
