# Ethernet configuration. Every platform must declare this via its platform flags.
#   Override: --//bazel/config/eth:eth_configuration=//path/to:your_eth_configuration
label_flag(
    name = "eth_configuration",
    build_setting_default = "//bazel/config:no_implementation",
    visibility = ["//visibility:public"],
)
