load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Always-incompatible target used as the default for every label_flag that has
# no universal implementation. A consuming target becomes incompatible with any
# platform that does not override the flag via platform flags.
cc_library(
    name = "no_implementation",
    target_compatible_with = ["@platforms//:incompatible"],
    visibility = ["//visibility:public"],
)
