load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel/config/build_variant:compatibility.bzl", "unit_test_only")

cc_library(
    name = "watchdog_for_test",
    hdrs = ["include/watchdog/Watchdog.h"],
    includes = [
        "include",
        "src",
    ],
    textual_hdrs = ["src/watchdog/Watchdog.cpp"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "safe_bsp_mcu_watchdog",
    srcs = ["src/watchdog/Watchdog.cpp"],
    hdrs = ["include/watchdog/Watchdog.h"],
    strip_include_prefix = "include",
    target_compatible_with = ["@platforms//os:none"],
    visibility = ["//visibility:public"],
    deps = ["//platforms/stm32/bsp/bspMcu:bsp_mcu"],
)

cc_test(
    name = "watchdog_test",
    srcs = [
        "test/include/mcu/mcu.h",
        "test/src/WatchdogTest.cpp",
    ],
    includes = ["test/include"],
    target_compatible_with = unit_test_only(),
    deps = [
        ":watchdog_for_test",
        "//libs/3rdparty/googletest:gtest",
        "//libs/3rdparty/googletest:gtest_main",
    ],
)
