load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel/config/build_variant:compatibility.bzl", "unit_test_only")

cc_library(
    name = "bx_can_transceiver",
    srcs = ["src/can/transceiver/bxcan/BxCanTransceiver.cpp"],
    hdrs = ["include/can/transceiver/bxcan/BxCanTransceiver.h"],
    strip_include_prefix = "include",
    target_compatible_with = ["//bazel/platform/constraints/soc:stm32f4"],
    visibility = ["//visibility:public"],
    deps = [
        "//libs/bsw/async",
        "//libs/bsw/cpp2can",
        "//libs/bsw/lifecycle",
        "//platforms/stm32/bsp/bspCan:bsp_can",
    ],
)

# Mock CAN device header for unit-test builds. The bspIo dep is omitted because
# bspIo is bare-metal-only and cannot build on a posix unit-test platform.
cc_library(
    name = "bx_can_device_mock",
    hdrs = ["test/mock/include/can/BxCanDevice.h"],
    strip_include_prefix = "test/mock/include",
    target_compatible_with = unit_test_only(),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bx_can_transceiver_mock_lib",
    srcs = ["src/can/transceiver/bxcan/BxCanTransceiver.cpp"],
    hdrs = ["include/can/transceiver/bxcan/BxCanTransceiver.h"],
    strip_include_prefix = "include",
    target_compatible_with = unit_test_only(),
    visibility = ["//visibility:public"],
    deps = [
        ":bx_can_device_mock",
        "//libs/3rdparty/etl",
        "//libs/3rdparty/googletest:gtest",
        "//libs/bsw/async:async_mock_impl",
        "//libs/bsw/bsp",
        "//libs/bsw/cpp2can",
        "//libs/bsw/lifecycle",
    ],
)
