load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel/config/build_variant:compatibility.bzl", "unit_test_only")

# CAN device implementations, one per controller type. Each is built only for
# the SoC family whose CAN controller it drives.
cc_library(
    name = "bsp_can_fdcan",
    srcs = ["src/can/FdCanDevice.cpp"],
    hdrs = [
        "include/can/BxCanDevice.h",
        "include/can/FdCanDevice.h",
    ],
    strip_include_prefix = "include",
    target_compatible_with = ["//bazel/platform/constraints/soc:stm32g4"],
    visibility = ["//visibility:public"],
    deps = [
        "//libs/3rdparty/etl",
        "//libs/bsw/cpp2can",
        "//platforms/stm32/bsp/bspMcu:bsp_mcu",
    ],
)

cc_library(
    name = "bsp_can_bxcan",
    srcs = ["src/can/BxCanDevice.cpp"],
    hdrs = [
        "include/can/BxCanDevice.h",
        "include/can/FdCanDevice.h",
    ],
    strip_include_prefix = "include",
    target_compatible_with = ["//bazel/platform/constraints/soc:stm32f4"],
    visibility = ["//visibility:public"],
    deps = [
        "//libs/3rdparty/etl",
        "//libs/bsw/cpp2can",
        "//platforms/stm32/bsp/bspMcu:bsp_mcu",
    ],
)

cc_library(
    name = "bx_can_device_for_test",
    hdrs = ["include/can/BxCanDevice.h"],
    includes = [
        "include",
        "src",
    ],
    textual_hdrs = ["src/can/BxCanDevice.cpp"],
    visibility = ["//visibility:private"],
    deps = [
        "//libs/3rdparty/etl",
        "//libs/bsw/cpp2can",
    ],
)

cc_library(
    name = "fd_can_device_for_test",
    hdrs = ["include/can/FdCanDevice.h"],
    includes = [
        "include",
        "src",
    ],
    textual_hdrs = ["src/can/FdCanDevice.cpp"],
    visibility = ["//visibility:private"],
    deps = [
        "//libs/3rdparty/etl",
        "//libs/bsw/cpp2can",
    ],
)

cc_test(
    name = "bx_can_device_test",
    srcs = [
        "test/include/mcu/mcu.h",
        "test/src/can/BxCanDeviceTest.cpp",
    ],
    includes = ["test/include"],
    target_compatible_with = unit_test_only(),
    deps = [
        ":bx_can_device_for_test",
        "//libs/3rdparty/googletest:gtest",
        "//libs/3rdparty/googletest:gtest_main",
        "//libs/bsw/bsp:bsp_mock",
        "//libs/bsw/util:util_mock",
    ],
)

cc_test(
    name = "fd_can_device_test",
    srcs = [
        "test/include/mcu/mcu.h",
        "test/src/can/FdCanDeviceTest.cpp",
    ],
    includes = ["test/include"],
    target_compatible_with = unit_test_only(),
    deps = [
        ":fd_can_device_for_test",
        "//libs/3rdparty/googletest:gtest",
        "//libs/3rdparty/googletest:gtest_main",
        "//libs/bsw/bsp:bsp_mock",
        "//libs/bsw/util:util_mock",
    ],
)

# Active CAN device implementation. Set by the platform via its flags.
# Non-STM32 and unit-test platforms resolve to no_implementation and skip this module.
#   Override: --//platforms/stm32/bsp/bspCan:bsp_can=//path/to:your_impl
label_flag(
    name = "bsp_can",
    build_setting_default = "//bazel/config:no_implementation",
    visibility = ["//visibility:public"],
)
