load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "bsp_mcu_chip_headers_g4",
    hdrs = [
        "include/3rdparty/st/stm32g4/stm32g474xx.h",
        "include/3rdparty/st/stm32g4/stm32g4xx.h",
        "include/3rdparty/st/stm32g4/system_stm32g4xx.h",
    ],
    strip_include_prefix = "include/3rdparty/st/stm32g4",
    target_compatible_with = ["//bazel/platform/constraints/soc:stm32g4"],
)

cc_library(
    name = "bsp_mcu_chip_headers_f4",
    hdrs = [
        "include/3rdparty/st/stm32f4/stm32f413xx.h",
        "include/3rdparty/st/stm32f4/stm32f4xx.h",
        "include/3rdparty/st/stm32f4/system_stm32f4xx.h",
    ],
    strip_include_prefix = "include/3rdparty/st/stm32f4",
    target_compatible_with = ["//bazel/platform/constraints/soc:stm32f4"],
)

alias(
    name = "bsp_mcu_chip_headers",
    actual = select({
        "//bazel/platform/constraints/soc:is_stm32g4": ":bsp_mcu_chip_headers_g4",
        "//bazel/platform/constraints/soc:is_stm32f4": ":bsp_mcu_chip_headers_f4",
        "//conditions:default": "//bazel/config:no_implementation",
    }),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bsp_mcu_chip_defines_g4",
    defines = [
        "STM32G474xx",
        "STM32_FAMILY_G4",
        "CAN_TYPE_FDCAN",
    ],
    target_compatible_with = ["//bazel/platform/constraints/soc:stm32g4"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bsp_mcu_chip_defines_f4",
    defines = [
        "STM32F413xx",
        "STM32_FAMILY_F4",
        "CAN_TYPE_BXCAN",
    ],
    target_compatible_with = ["//bazel/platform/constraints/soc:stm32f4"],
    visibility = ["//visibility:public"],
)

alias(
    name = "bsp_mcu_chip_defines",
    actual = select({
        "//bazel/platform/constraints/soc:is_stm32g4": ":bsp_mcu_chip_defines_g4",
        "//bazel/platform/constraints/soc:is_stm32f4": ":bsp_mcu_chip_defines_f4",
        "//conditions:default": "//bazel/config:no_implementation",
    }),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bsp_mcu_startup_g4",
    srcs = ["startup/startup_stm32g474xx.S"],
    target_compatible_with = [
        "//bazel/platform/constraints/soc:stm32g4",
        "@platforms//os:none",
    ],
)

cc_library(
    name = "bsp_mcu_startup_f4",
    srcs = ["startup/startup_stm32f413xx.S"],
    target_compatible_with = [
        "//bazel/platform/constraints/soc:stm32f4",
        "@platforms//os:none",
    ],
)

alias(
    name = "bsp_mcu_startup",
    actual = select({
        "//bazel/platform/constraints/soc:is_stm32g4": ":bsp_mcu_startup_g4",
        "//bazel/platform/constraints/soc:is_stm32f4": ":bsp_mcu_startup_f4",
        "//conditions:default": "//bazel/config:no_implementation",
    }),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bsp_mcu",
    srcs = ["src/reset/softwareSystemReset.cpp"],
    hdrs = [
        "include/mcu/mcu.h",
        "include/reset/softwareSystemReset.h",
    ],
    strip_include_prefix = "include",
    target_compatible_with = ["@platforms//os:none"],
    visibility = ["//visibility:public"],
    deps = [
        ":bsp_mcu_chip_defines",
        ":bsp_mcu_chip_headers",
        ":bsp_mcu_startup",
        "//libs/3rdparty/cmsis",
    ],
)
