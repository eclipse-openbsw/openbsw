From the eclipse-threadx/threadx Cortex-M0 port, upstream tag v6.4.3.202503_rel.

Both files pop the saved link register directly, which is not encodable on
ARMv6-M and makes the Cortex-M0+ port fail to assemble as soon as
TX_ENABLE_EXECUTION_CHANGE_NOTIFY is set (which this platform does, so the async
framework gets its task enter/leave callbacks). The fix restores LR through a
scratch register, which is exactly what the rest of the same port already does,
for example in the __tx_SysTickHandler of ports/cortex_m0/gnu/example_build.

Clang (integrated assembler) compatibility:
- tx_thread_system_return.S used `.text 32` (subsection 32). Clang then fails to
  resolve the Thumb-1 `LDR rX, =imm` literal pool reference ("out of range
  pc-relative fixup value", even with an explicit `.ltorg`). Plain `.text` is
  equivalent for this single-function object.
- tx_thread_schedule.S used `LDR rX, =#imm`; clang rejects the `#` ("unknown
  token in expression"). `=imm` is the canonical form and also what GCC expects.

Always reapply these modifications when the vendored port is updated.

diff --git a/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_context_save.S b/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_context_save.S
--- a/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_context_save.S
+++ b/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_context_save.S
@@ -87,7 +87,8 @@
     /* Call the ISR enter function to indicate an ISR is starting.  */
     PUSH    {r0, lr}                                // Save return address
     BL      _tx_execution_isr_enter                 // Call the ISR enter function
-    POP     {r0, lr}                                // Recover return address
+    POP     {r0, r1}                                // Recover return address
+    MOV     lr, r1                                  // ARMv6-M cannot POP into LR
 #endif

diff --git a/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_system_return.S b/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_system_return.S
--- a/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_system_return.S
+++ b/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_system_return.S
@@ -23,7 +23,7 @@
 #include "tx_user.h"
 #endif
 
-    .text 32
+    .text
     .align 4
     .syntax unified
 @/**************************************************************************/

diff --git a/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_schedule.S b/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_schedule.S
--- a/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_schedule.S
+++ b/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_schedule.S
@@ -108,8 +108,8 @@
 @
 @    /* Enter the scheduler for the first time.  */
 @
-    LDR     r0, =#0x10000000                        @ Load PENDSVSET bit
-    LDR     r1, =#0xE000ED04                        @ Load NVIC base
+    LDR     r0, =0x10000000                         @ Load PENDSVSET bit
+    LDR     r1, =0xE000ED04                         @ Load NVIC base
     STR     r0, [r1]                                @ Set PENDSVBIT in ICSR
     DSB                                             @ Complete all memory accesses
     ISB                                             @ Flush pipeline

diff --git a/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_context_restore.S b/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_context_restore.S
--- a/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_context_restore.S
+++ b/platforms/rp2xxx/3rdparty/threadx/ports/cortex_m0/gnu/src/tx_thread_context_restore.S
@@ -96,7 +96,8 @@
     /* Call the ISR exit function to indicate an ISR is complete.  */
     PUSH    {r0, lr}                                // Save return address
     BL      _tx_execution_isr_exit                  // Call the ISR exit function
-    POP     {r0, lr}                                // Recover return address
+    POP     {r0, r1}                                // Recover return address
+    MOV     lr, r1                                  // ARMv6-M cannot POP into LR
 #endif
