load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "bsp_core",
    srcs = ["src/cache/cache.cpp"],
    hdrs = ["include/cache/cache.h"],
    implementation_deps = ["//platforms/s32k1xx/bsp/bspMcu:bsp_mcu"],
    strip_include_prefix = "include",
    target_compatible_with = ["//bazel/platform/constraints/soc:s32k148"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "bsp_core_test",
    srcs = [
        "include/cache/cache.h",
        "test/src/IncludeTest.cpp",
    ],
    includes = ["include"],
    target_compatible_with = ["//bazel/platform/constraints/build_variant:unit_test"],
    deps = ["//libs/3rdparty/googletest:gtest_main"],
)
