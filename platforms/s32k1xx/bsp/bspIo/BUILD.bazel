load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "bsp_io_headers",
    hdrs = [
        "include/io/Io.h",
        "include/io/ioPorts.h",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":bsp_configuration",
        "//libs/3rdparty/etl",
        "//libs/bsw/bsp",
        "//platforms/s32k1xx/bsp/bspAdc:bsp_adc",  # required by AnalogInput.h (transitive include) which is not in CMake target_link_libraries
        "//platforms/s32k1xx/bsp/bspEepromDriver:bsp_eeprom_driver",  # required by EepromConfiguration.h (transitive include) which is not in CMake target_link_libraries
    ],
)

cc_library(
    name = "bsp_io_impl",
    srcs = ["src/io/Io.cpp"],
    target_compatible_with = ["//bazel/platform/constraints/soc:s32k148"],
    visibility = ["//visibility:public"],
    deps = [
        ":bsp_io_headers",
        "//platforms/s32k1xx/bsp/bspAdc:bsp_adc",
        "//platforms/s32k1xx/bsp/bspEepromDriver:bsp_eeprom_driver",
        "//platforms/s32k1xx/bsp/bspMcu:bsp_mcu",
    ],
)

alias(
    name = "bsp_io_default",
    actual = select(
        {
            "//bazel/platform/constraints/soc:s32k148": ":bsp_io_impl",
            "@platforms//os:linux": "//executables/unitTest/bsp/bspIo:bsp_io",
        },
        no_match_error = "No bsp_io for this platform.",
    ),
    visibility = ["//visibility:public"],
)

label_flag(
    name = "bsp_io",
    build_setting_default = ":bsp_io_default",
    visibility = ["//visibility:public"],
)

alias(
    name = "bsp_configuration_default",
    actual = select(
        {
            "//bazel/platform/constraints/soc:s32k148": "//executables/referenceApp/platforms/s32k148evb/bspConfiguration:bsp_configuration_headers",
            "@platforms//os:linux": "//executables/referenceApp/platforms/posix/bspConfiguration:bsp_configuration_headers",
        },
        no_match_error = "No bsp_configuration for this platform. Override --//<path>:bsp_configuration with your own implementation.",
    ),
    visibility = ["//visibility:public"],
)

label_flag(
    name = "bsp_configuration",
    build_setting_default = ":bsp_configuration_default",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bsp_io_mock",
    testonly = True,
    srcs = ["mock/gmock/src/IoMock.cpp"],
    hdrs = [
        "mock/gmock/include/io/IoMock.h",
    ],
    implementation_deps = [
        ":bsp_io",
        "//libs/3rdparty/googletest:gtest_main",
    ],
    strip_include_prefix = "mock/gmock/include",
    target_compatible_with = ["@platforms//:incompatible"],
    visibility = ["//visibility:public"],
)
