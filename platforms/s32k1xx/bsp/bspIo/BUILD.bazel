load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel/config/build_variant:compatibility.bzl", "unit_test_only")

cc_library(
    name = "bsp_io",
    srcs = ["src/io/Io.cpp"],
    hdrs = [
        "include/io/Io.h",
        "include/io/ioPorts.h",
    ],
    strip_include_prefix = "include",
    target_compatible_with = ["//bazel/platform/constraints/soc:s32k148"],
    visibility = ["//visibility:public"],
    deps = [
        "//bazel/config/bsp:bsp_configuration",
        "//libs/3rdparty/etl",
        "//libs/bsw/bsp",
        "//platforms/s32k1xx/bsp/bspMcu:bsp_mcu",
    ],
)

# There is no bsp_io_mock target because the CMake bspIoMock library never builds.
# The s32k1xx bspIo directory is added only for non unit-test builds, while bspIoMock is
# guarded to unit-test builds, so the two conditions never overlap. The mock source also
# matches neither the unit-test nor the s32k1xx Io interface, and nothing depends on it.

cc_test(
    name = "bsp_io_test",
    srcs = ["test/src/IncludeTest.cpp"],
    target_compatible_with = unit_test_only(),
    deps = [
        "//executables/unitTest/bsp/bspIo:bsp_io",
        "//executables/unitTest/bsp/bspMcu:ut_bsp_mcu",
        "//libs/3rdparty/googletest:gtest_main",
    ],
)
