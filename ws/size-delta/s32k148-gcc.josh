:$label="S32K148 GCC size delta"
:#image[:+ws/common/dev-image]
:$output="none"

inputs = :[
    :#baseline[
        :+ws/size-delta/s32k148-gcc-snapshot

        worktree = :[
            source = :[
                :$.={#baseline|#^}
                ::ws/size-delta/s32k148-gcc-source.josh
            ]:+ws/size-delta/s32k148-gcc-source
        ]
    ]
    :#current[
        :+ws/size-delta/s32k148-gcc-snapshot

        worktree = :[
            source = :+ws/size-delta/s32k148-gcc-source
        ]
    ]
]

worktree = :[
    :/ws/size-delta::analyze.py=s32k148-gcc.analyze.py
    :/ws/size-delta::run.sh=s32k148-gcc.run.sh
]
