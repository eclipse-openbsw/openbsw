load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//libs/bsw/middleware:configurable_middleware.bzl", "middleware_config")
load("//libs/bsw/middleware/tools:codegen.bzl", "run_codegen")
load(":generated_outputs.bzl", "GENERATED_OUTPUTS")

package(default_visibility = ["//executables/referenceApp/middlewareConfiguration:__subpackages__"])

# ---------------------------------------------------------------------------
# ReferenceApp Platform integration targets
# ---------------------------------------------------------------------------

cc_library(
    name = "concurrency_impl",
    hdrs = ["include/platform_integration/middleware/concurrency/lock_types.h"],
    strip_include_prefix = "include/platform_integration",
)

cc_library(
    name = "logger_impl",
    srcs = ["src/platform_integration/logger/LoggerImpl.cpp"],
    deps = [
        "//executables/referenceApp/application:headers",
        "//libs/3rdparty/etl",
        "//libs/bsw/logger",
        "//libs/bsw/middleware/interfaces:logger",
        "//libs/bsw/util",
    ],
)

cc_library(
    name = "os_impl",
    srcs = ["src/platform_integration/os/OsDefinitions.cpp"],
    deps = [
        "//executables/referenceApp/asyncBinding:async_binding",
        "//libs/bsw/middleware/interfaces:os",
    ],
)

cc_library(
    name = "time_impl",
    srcs = ["src/platform_integration/time/SystemTimeProvider.cpp"],
    deps = [
        "//libs/bsw/bsp",
        "//libs/bsw/middleware/interfaces:time",
    ],
)

# ---------------------------------------------------------------------------
# ReferenceApp code generation targets
# ---------------------------------------------------------------------------

run_codegen(
    name = "generate_code",
    outs = GENERATED_OUTPUTS,
    deployment = "model/deployment.yaml",
    generated_files_prefix = "generated_files",
    tool = "//libs/bsw/middleware/tools/cpp_generator:jinja2cpp",
)

filegroup(
    name = "generated_headers",
    srcs = [":generate_code"],
    output_group = "generated_headers",
)

filegroup(
    name = "generated_sources",
    srcs = [":generate_code"],
    output_group = "generated_sources",
)

# ---------------------------------------------------------------------------
# ReferenceApp middleware configuration targets
# ---------------------------------------------------------------------------

cc_library(
    name = "generated_middleware_impl",
    srcs = [":generated_sources"],
    hdrs = [":generated_headers"],
    strip_include_prefix = "generated_files/include/generated_code",
    deps = ["//libs/bsw/middleware"],
    alwayslink = True,
)

cc_library(
    name = "middleware_impl",
    srcs = [
        "src/MemoryLayout.cpp",
    ],
    hdrs = ["include/MemoryLayout.h"],
    strip_include_prefix = "include",
    deps = [":generated_middleware_impl"],
)

middleware_config(
    name = "middlewareConfiguration",
    config = {
        "//libs/3rdparty/etl:etl_profile": "//executables/referenceApp/etl_profile:etl_profile",
        "//libs/bsw/middleware/interfaces:concurrency_impl": ":concurrency_impl",
        "//libs/bsw/middleware/interfaces:logger_impl": ":logger_impl",
        "//libs/bsw/middleware/interfaces:os_impl": ":os_impl",
        "//libs/bsw/middleware/interfaces:time_impl": ":time_impl",
    },
    dep = ":middleware_impl",
)
