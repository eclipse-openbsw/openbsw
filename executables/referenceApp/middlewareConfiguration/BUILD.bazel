load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel/config/build_variant:compatibility.bzl", "reference_app_posix_only")
load(
    "//libs/bsw/middleware/tools/cpp_generator:middleware_codegen.bzl",
    "middleware_codegen",
)
load(":generated_outputs.bzl", "GENERATED_OUTPUTS")

# Bound by the posix platform to the middleware platform integration flags.
cc_library(
    name = "middleware_concurrency",
    hdrs = ["platform_integration/concurrency/include/middleware/concurrency/lock_types.h"],
    strip_include_prefix = "platform_integration/concurrency/include",
    target_compatible_with = reference_app_posix_only(),
    visibility = ["//libs/bsw/middleware:__pkg__"],
)

cc_library(
    name = "middleware_logger",
    srcs = ["platform_integration/logger/src/LoggerImpl.cpp"],
    target_compatible_with = reference_app_posix_only(),
    visibility = ["//libs/bsw/middleware:__pkg__"],
    deps = [
        "//executables/referenceApp/application:demo_logger",
        "//libs/3rdparty/etl",
        "//libs/bsw/middleware:middleware_interfaces",
        "//libs/bsw/util",
    ],
)

cc_library(
    name = "middleware_os",
    srcs = ["platform_integration/os/src/OsDefinitions.cpp"],
    target_compatible_with = reference_app_posix_only(),
    visibility = ["//libs/bsw/middleware:__pkg__"],
    deps = [
        "//executables/referenceApp/asyncBinding:async_binding",
        "//libs/bsw/middleware:middleware_interfaces",
    ],
)

cc_library(
    name = "middleware_time",
    srcs = ["platform_integration/time/src/SystemTimeProvider.cpp"],
    target_compatible_with = reference_app_posix_only(),
    visibility = ["//libs/bsw/middleware:__pkg__"],
    deps = [
        "//libs/bsw/bsp",
        "//libs/bsw/middleware:middleware_interfaces",
    ],
)

middleware_codegen(
    name = "middleware_configuration_generated",
    deployment_yaml = "model/deployment.yaml",
    generated_outputs = GENERATED_OUTPUTS,
    visibility = ["//visibility:public"],
    deps = ["//libs/bsw/middleware"],
)

cc_library(
    name = "middleware_configuration",
    srcs = ["src/MemoryLayout.cpp"],
    hdrs = ["include/MemoryLayout.h"],
    strip_include_prefix = "include",
    target_compatible_with = reference_app_posix_only(),
    visibility = ["//visibility:public"],
    deps = [
        ":middleware_configuration_generated",
        "//libs/bsw/middleware",
    ],
)
